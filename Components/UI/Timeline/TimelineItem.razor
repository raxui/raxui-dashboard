@* RaxUI TimelineItem. Source-owned: edit freely. Styled by the timeline component CSS. *@
<li @attributes="AdditionalAttributes" class="@($"rax-timeline-item {Class}")" style="@($"--rax-timeline-i:{Index};{(AdditionalAttributes?.TryGetValue("style", out var style) == true ? style : null)}")" data-status="@Status" data-side="@(TimelineContext?.EffectiveTimePosition=="side"?(TimelineContext.Layout=="alternate"&&Index%2==1?"start":"end"):null)" data-tone="@(Tone ?? (Status == "error" ? "danger" : Status == "upcoming" ? "neutral" : "primary"))" data-marker="@(Marker is null ? "dot" : "icon")" aria-current="@(Status == "current" ? "step" : null)" data-rax-appearance="@Appearance">
    @if (TimelineContext?.EffectiveTimePosition == "side") { <div class="rax-timeline-side">@TimeMarkup</div> }
    <div class="rax-timeline-rail" aria-hidden="true"><span class="rax-timeline-marker">@Marker</span><span class="rax-timeline-line"></span></div>
    <div class="rax-timeline-body">
        @if (TimelineContext?.EffectiveTimePosition != "side") { @TimeMarkup }
        @if (Title is not null || TitleContent is not null) { <div class="rax-timeline-title">@if(TitleContent is not null){@TitleContent}else{@Title}<span class="visually-hidden"> (@(StatusLabel ?? TimelineContext?.StatusLabel(Status) ?? Status))</span></div> }
        @if (Description is not null) { <div class="rax-timeline-description">@Description</div> }
        @if (ChildContent is not null) { <div class="rax-timeline-content">@ChildContent</div> }
    </div>
</li>
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>default, flat, or glass; null inherits the surrounding theme.</summary>
    [Parameter] public string? Appearance { get; set; }
    /// <summary>Extra CSS classes.</summary>
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [CascadingParameter] private Timeline? TimelineContext { get; set; }
    /// <summary>Optional zero-based entrance animation stagger.</summary>
    [Parameter] public int Index { get; set; }
    [Parameter] public string Status { get; set; } = "done";
    [Parameter] public string? Tone { get; set; }
    [Parameter] public RenderFragment? TitleContent { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Time { get; set; }
    [Parameter] public string? DateTime { get; set; }
    [Parameter] public RenderFragment? Marker { get; set; }
    [Parameter] public string? StatusLabel { get; set; }
    private RenderFragment TimeMarkup => @<text>@if (Time is not null) { <time class="rax-timeline-time" datetime="@DateTime">@Time</time> }</text>;
}
