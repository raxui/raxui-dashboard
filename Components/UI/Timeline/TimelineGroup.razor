@* RaxUI TimelineGroup. Source-owned: edit freely. Styled by the timeline component CSS. *@
<li @attributes="AdditionalAttributes" class="@($"rax-timeline-group {Class}")" data-rax-appearance="@Appearance"><span class="rax-timeline-group-label">@ChildContent</span></li>
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>default, flat, or glass; null inherits the surrounding theme.</summary>
    [Parameter] public string? Appearance { get; set; }
    /// <summary>Extra CSS classes.</summary>
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
}
