@if (Parent?.Mobile == true && Collapsible != "none") {
<Sheet Open="@Parent.MobileOpen" OpenChanged="Parent.SetMobileOpen" Side="@Side" id="@Parent.PanelId" Title="@Label" Description="@Description" ShowCloseButton="false" ShowHandle="false" Class="@($"rax-sidebar-sheet {Class}")" HeaderClass="visually-hidden" BodyClass="p-0 d-flex flex-column" Appearance="@Parent.Appearance"><nav class="rax-sidebar-inner" aria-label="@Label" data-mobile>@ChildContent</nav></Sheet>
} else {
<div @attributes="AdditionalAttributes" class="rax-sidebar @Class" data-state="@(Parent?.Current == false ? "collapsed" : "expanded")" data-collapsible="@(Parent?.Current == false ? Collapsible : "none")" data-variant="@Variant" data-side="@Side" id="@Parent?.PanelId"><nav class="rax-sidebar-inner" aria-label="@Label" inert="@(Parent?.Ready == true && !Parent.Current && Collapsible == "offcanvas")">@ChildContent</nav></div>
}
@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [CascadingParameter] public SidebarProvider? Parent { get; set; }
    [Parameter] public string Side { get; set; } = "start";
    [Parameter] public string Variant { get; set; } = "sidebar";
    [Parameter] public string Collapsible { get; set; } = "offcanvas";
    [Parameter] public string Label { get; set; } = "Sidebar";
    [Parameter] public string Description { get; set; } = "Navigation";
}
