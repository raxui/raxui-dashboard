@* Lucide PanelLeft, ISC. *@
<button @attributes="AdditionalAttributes" type="button" class="btn rax-button btn-glass btn-glass-ghost btn-glass-icon btn-sm rax-sidebar-trigger @Class" aria-label="@Label" aria-controls="@Parent?.PanelId" aria-expanded="@((Parent?.Mobile == true ? Parent.MobileOpen : Parent?.Current == true) ? "true" : "false")" disabled="@(Parent?.Ready != true)" @onclick="Toggle"><svg class="" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4v16M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" /></svg>@ChildContent</button>
@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [CascadingParameter] public SidebarProvider? Parent { get; set; }
    [Parameter] public string Label { get; set; } = "Toggle sidebar";
    private Task Toggle() => Parent?.Toggle() ?? Task.CompletedTask;
}
