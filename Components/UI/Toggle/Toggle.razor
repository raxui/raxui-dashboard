@* RaxUI Toggle. Source-owned: edit freely. Requires an interactive render mode. *@
<button @attributes="AdditionalAttributes" type="button" class="@($"rax-toggle rax-toggle-{Variant} rax-toggle-{Size} {Class}")" data-rax-appearance="@Appearance"
        disabled="@Disabled" aria-pressed="@(Current ? "true" : "false")" data-state="@(Current ? "on" : "off")" @onclick="TogglePressed">@ChildContent</button>
@code {
    [Parameter] public bool Pressed { get; set; }
    [Parameter] public EventCallback<bool> PressedChanged { get; set; }
    [Parameter] public bool DefaultPressed { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Variant { get; set; } = "default";
    [Parameter] public string Size { get; set; } = "default";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool? _pressed;
    private bool Current => PressedChanged.HasDelegate ? Pressed : _pressed ?? (Pressed || DefaultPressed);
    private async Task TogglePressed()
    {
        var next = !Current;
        if (!PressedChanged.HasDelegate) _pressed = next;
        await PressedChanged.InvokeAsync(next);
    }
    [Parameter] public string? Appearance { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
}
