@* RaxUI ToggleGroupItem. Source-owned: edit freely. Requires ToggleGroup and interactivity. *@
<button @attributes="AdditionalAttributes" type="button" class="@($"rax-toggle rax-toggle-{Group?.Variant} rax-toggle-{Group?.Size} {Class}")"
        disabled="@(Disabled || Group?.Disabled == true)" aria-pressed="@(Group?.Contains(Value) == true ? "true" : "false")"
        data-state="@(Group?.Contains(Value) == true ? "on" : "off")" @onclick="Select">@ChildContent</button>
@code {
    [CascadingParameter] public ToggleGroup? Group { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private Task Select() => Group?.Select(Value) ?? Task.CompletedTask;
    [Parameter] public string? Appearance { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
}
