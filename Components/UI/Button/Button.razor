@* RaxUI Button. Source-owned: edit freely. Styled by the shared theme (css/raxui/raxui.css, ADR 007),
   with the same classes and options as the React Button. *@

<button @attributes="AdditionalAttributes"
        type="@Type"
        class="@CssClass"
        style="@Style"
        disabled="@Disabled"
        data-rax-appearance="@Appearance"
        @onclick="OnClick">
    @ChildContent
</button>

@code {
    private static readonly Dictionary<string, string> VariantClasses = new()
    {
        ["default"] = "btn-glass-primary",
        ["solid"] = "btn-glass-primary",
        ["secondary"] = "btn-glass-secondary",
        ["tinted"] = "btn-glass-tinted",
        ["destructive"] = "btn-glass-destructive",
        ["outline"] = "btn-glass-outline",
        ["ghost"] = "btn-glass-ghost",
        ["link"] = "btn-glass-link",
    };

    private static readonly Dictionary<string, string?> SizeClasses = new()
    {
        ["default"] = null,
        ["sm"] = "btn-sm",
        ["lg"] = "btn-lg",
        ["icon"] = "btn-glass-icon",
        ["icon-sm"] = "btn-glass-icon btn-sm",
        ["icon-lg"] = "btn-glass-icon btn-lg",
    };

    /// <summary>default, solid, secondary, tinted, destructive, outline, ghost, or link.</summary>
    [Parameter] public string Variant { get; set; } = "default";

    /// <summary>default, sm, lg, icon, icon-sm, or icon-lg.</summary>
    [Parameter] public string Size { get; set; } = "default";

    /// <summary>default, flat, or glass. When null, the button inherits it from the nearest ancestor with data-rax-appearance.</summary>
    [Parameter] public string? Appearance { get; set; }

    /// <summary>A Bootstrap theme color (primary, success, danger, …) that tints the button.</summary>
    [Parameter] public string? Color { get; set; }

    /// <summary>The native button type: button, submit, or reset.</summary>
    [Parameter] public string Type { get; set; } = "button";

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Extra CSS classes appended after the component's own classes.</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => string.Join(" ", new[]
    {
        "btn rax-button btn-glass",
        VariantClasses.GetValueOrDefault(Variant, "btn-glass-primary"),
        SizeClasses.GetValueOrDefault(Size),
        Class,
    }.Where(part => !string.IsNullOrEmpty(part)));

    private string? Style
    {
        get
        {
            var userStyle = AdditionalAttributes?.TryGetValue("style", out var value) == true ? value?.ToString() : null;
            // Only a plain color name may reach the CSS variable.
            if (string.IsNullOrEmpty(Color) || !Color.All(c => char.IsAsciiLetterOrDigit(c) || c == '-'))
                return userStyle;
            return $"--rax-btn-tint-rgb: var(--bs-{Color}-rgb);{(userStyle is null ? "" : " " + userStyle)}";
        }
    }
}
