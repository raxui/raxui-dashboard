@* RaxUI Progress. Source-owned: edit freely. Styled by the progress component CSS. *@
<div class="rax-progress-field" data-rax-appearance="@Appearance" data-complete="@(CurrentValue == EffectiveMax ? "true" : null)">
    @if (Label is not null || ShowValue)
    {
        <div class="rax-progress-label-row">
            @if (Label is not null) { <span id="@_labelId" class="rax-progress-label">@Label</span> }
            @if (ShowValue && CurrentValue is double labelValue) { <span class="rax-progress-value" aria-hidden="true">@FormatValue(labelValue, EffectiveMax)</span> }
        </div>
    }
    <div @attributes="AdditionalAttributes" class="@($"rax-progress {Class}")" role="progressbar" aria-label="@(Label is null ? AccessibleLabel : null)" aria-labelledby="@(Label is not null ? _labelId : null)"
         aria-valuemin="0" aria-valuemax="@Number(EffectiveMax)" aria-valuenow="@(CurrentValue is double value ? Number(value) : null)" aria-valuetext="@(CurrentValue is double current ? FormatValue(current, EffectiveMax) : null)"
         data-state="@(CurrentValue is null ? "indeterminate" : CurrentValue == EffectiveMax ? "complete" : "loading")" data-value="@(CurrentValue is double val ? Number(val) : null)" data-size="@Size" data-color="@(SuccessOnComplete && CurrentValue == EffectiveMax ? "success" : Color)" data-segmented="@(Segments > 0 && CurrentValue is not null ? "true" : null)">
        @if (Segments > 0 && CurrentValue is not null)
        {
            @for (var i = 0; i < Segments; i++)
            {
                var fill = Math.Clamp(CurrentValue.Value / EffectiveMax * Segments - i, 0, 1);
                <span class="rax-progress-segment"><span class="rax-progress-indicator" data-empty="@(fill == 0 ? "true" : null)" style="@($"transform:translateX({Number((fill - 1) * 100)}%)")"></span></span>
            }
        }
        else { <span class="rax-progress-indicator" style="@(CurrentValue is double indicatorValue ? $"transform:translateX({Number(indicatorValue / EffectiveMax * 100 - 100)}%)" : null)"></span> }
    </div>
</div>
@code {
    /// <summary>default, flat, or glass; null inherits the surrounding theme.</summary>
    [Parameter] public string? Appearance { get; set; }
    /// <summary>Extra CSS classes.</summary>
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    /// <summary>Null is indeterminate. Finite values are clamped to 0..Max.</summary>
    [Parameter] public double? Value { get; set; }
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public string? Label { get; set; }
    [Parameter] public string AccessibleLabel { get; set; } = "Progress";
    [Parameter] public bool ShowValue { get; set; }
    [Parameter] public string Color { get; set; } = "primary";
    [Parameter] public string Size { get; set; } = "default";
    [Parameter] public int Segments { get; set; }
    [Parameter] public bool SuccessOnComplete { get; set; }
    [Parameter] public Func<double, double, string> FormatValue { get; set; } = (value, max) => $"{Math.Round(value / max * 100)}%";
    private readonly string _labelId = $"rax-progress-{Guid.NewGuid():N}";
    private double EffectiveMax => double.IsFinite(Max) && Max > 0 ? Max : 100;
    private double? CurrentValue => Value is double v && double.IsFinite(v) ? Math.Clamp(v, 0, EffectiveMax) : null;
    private static string Number(double value) => value.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
