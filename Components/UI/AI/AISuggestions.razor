<div @attributes="AdditionalAttributes" class="rax-ai-suggestions @Class">
@for (var i = 0; i < Suggestions.Count; i++) { var suggestion = Suggestions[i];
<button @key="suggestion" type="button" class="rax-ai-suggestion" style="@($"--rax-i:{i}")" dir="auto" @onclick="() => OnSelect.InvokeAsync(suggestion)">@suggestion</button> }
</div>
@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Suggestions { get; set; } = Array.Empty<string>();
    [Parameter] public EventCallback<string> OnSelect { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
}
