@using RaxUI.Internal.AI
<div @attributes="AdditionalAttributes" class="rax-ai-sources @Class">
<span class="rax-ai-sources-label">@Label.Replace("{n}", Sources.Count.ToString(System.Globalization.CultureInfo.CurrentCulture))</span>
<ol>@for (var i = 0; i < Sources.Count; i++) { var source = Sources[i];
<li @key="source.Url"><a href="@AIMarkdownParser.SafeUrl(source.Url)" target="_blank" rel="noreferrer" class="rax-ai-source" title="@source.Title"><span class="rax-ai-source-index">@(i + 1)</span><span class="rax-ai-source-title">@source.Title</span><span class="rax-ai-source-host">@Host(source.Url)</span></a></li> }</ol>
</div>
@code {
    [Parameter, EditorRequired] public IReadOnlyList<AITypes.Source> Sources { get; set; } = Array.Empty<AITypes.Source>();
    /// <summary>{n} is replaced with the count.</summary>
    [Parameter] public string Label { get; set; } = "{n} sources";
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    private static string Host(string url) => Uri.TryCreate(url, UriKind.Absolute, out var uri) && uri.Host.Length > 0 ? (uri.Host.StartsWith("www.", StringComparison.Ordinal) ? uri.Host[4..] : uri.Host) : url;
}
