@* RaxUI FieldSet. Source-owned: edit freely. A native fieldset for one question with multiple controls. *@
@using System.Linq.Expressions

<Field IsFieldSet For="For" Id="@Id" Invalid="Invalid" Required="Required" Optional="Optional" Disabled="Disabled"
       Description="Description" HasDescription="HasDescription" HasError="HasError" Error="@Error" Class="@Class" Appearance="@Appearance"
       AdditionalAttributes="AdditionalAttributes" ChildContent="ChildContent" />

@code {
    /// <summary>Bound property for validation and the Required hint.</summary>
    [Parameter] public Expression<Func<object?>>? For { get; set; }
    /// <summary>Base id for the group's label, description, and error.</summary>
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool? Invalid { get; set; }
    [Parameter] public bool? Required { get; set; }
    [Parameter] public bool Optional { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? Description { get; set; }
    /// <summary>Set when composing FieldDescription manually inside the group.</summary>
    [Parameter] public bool HasDescription { get; set; }
    /// <summary>Set when composing FieldError with custom content.</summary>
    [Parameter] public bool HasError { get; set; }
    [Parameter] public string? Error { get; set; }
    /// <summary>default, flat, or glass; null inherits the surrounding theme.</summary>
    [Parameter] public string? Appearance { get; set; }
    /// <summary>Extra CSS classes appended after the component's own classes.</summary>
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment<Field.FieldContext>? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
}
