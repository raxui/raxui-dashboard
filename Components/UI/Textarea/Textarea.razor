@* RaxUI Textarea. Source-owned: edit freely. Native form behavior also works in static SSR. *@
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_element" class="@(Grouped ? $"rax-textarea-group {WrapperClass}" : WrapperClass)" dir="@ControlDirection" data-rax-appearance="@Appearance"
     data-auto-resize="@(AutoResize ? "true" : null)" data-min-rows="@MinRows" data-max-rows="@MaxRows">
    <TextareaInput @attributes="ControlAttributes" class="@($"form-control rax-textarea {Class} {ExtraClass}".TrimEnd())"
                   data-variant="@Variant" data-auto-resize="@(AutoResize ? "" : null)" data-rax-appearance="@Appearance"
                   OnInput="OnInput" Value="@Value" ValueChanged="Changed" ValueExpression="OwnValueExpression" @onkeydown="OnKeyDown" />
    @if (Grouped)
    {
        <div class="rax-textarea-footer">
            <div class="rax-textarea-footer-start">@Footer</div>
            @if (ShowCount && MaxLength is > 0)
            {
                <span class="rax-textarea-count" data-state="@CountState" data-count-max="@MaxLength" data-limit-label="@LimitLabel">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><circle class="rax-textarea-count-track" cx="10" cy="10" r="8" /><circle class="rax-textarea-count-bar" cx="10" cy="10" r="8" pathLength="1" style="@($"stroke-dashoffset:{(1 - Math.Min((double)Length / MaxLength.Value, 1)).ToString(System.Globalization.CultureInfo.InvariantCulture)}")" /></svg>
                    <span class="rax-textarea-count-text" dir="ltr">@(CountState is null ? $"{Length} / {MaxLength}" : $"{MaxLength - Length}")</span>
                    <span class="visually-hidden" role="status" data-count-status>@(CountState == "limit" ? LimitLabel : "")</span>
                </span>
            }
            @FooterEnd
        </div>
    }
</div>
@code {
    /// <summary>Grow between MinRows and MaxRows after an interactive render.</summary>
    [Parameter] public bool AutoResize { get; set; }
    [Parameter] public int MinRows { get; set; } = 3;
    [Parameter] public int MaxRows { get; set; } = 10;
    [Parameter] public string Variant { get; set; } = "filled";
    [Parameter] public bool Invalid { get; set; }
    [Parameter] public bool ShowCount { get; set; }
    [Parameter] public int? MaxLength { get; set; }
    [Parameter] public string LimitLabel { get; set; } = "Character limit reached";
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public RenderFragment? FooterEnd { get; set; }
    [Parameter] public string? WrapperClass { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnInput { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    private bool Grouped => Footer is not null || FooterEnd is not null || ShowCount && MaxLength is > 0;
    private int Length => Value?.Length ?? 0;
    private string? CountState => MaxLength is not > 0 ? null : Length >= MaxLength ? "limit" : MaxLength - Length <= Math.Max(10, (int)Math.Round(MaxLength.Value * .1, MidpointRounding.AwayFromZero)) ? "warn" : null;
    private string? ControlDirection => AdditionalAttributes is not null && AdditionalAttributes.TryGetValue("dir", out var dir) ? Convert.ToString(dir) : null;
    private async Task Changed(string? value) { Value = value; await ValueChanged.InvokeAsync(value); }

    /// <summary>Bound value, including EditContext validation and static SSR form mapping.</summary>
    [Parameter] public string? Value { get; set; } = "";
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<string?>>? ValueExpression { get; set; }
    // Unbound use (no @bind-Value): the inner input still needs an expression, so point it at this component's own value.
    private System.Linq.Expressions.Expression<Func<string?>>? _ownValueExpression;
    private System.Linq.Expressions.Expression<Func<string?>> OwnValueExpression => ValueExpression ?? (_ownValueExpression ??= () => Value);

    [CascadingParameter] private Field.FieldContext? FieldContext { get; set; }
    /// <summary>default, flat, or glass; null inherits the surrounding theme.</summary>
    [Parameter] public string? Appearance { get; set; }
    /// <summary>Extra CSS classes appended to the control.</summary>
    [Parameter] public string? Class { get; set; }
    private string? ExtraClass => AdditionalAttributes is not null && AdditionalAttributes.TryGetValue("class", out var value) ? Convert.ToString(value) : null;
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    private readonly string _autoId = $"rax-control-{Guid.NewGuid():N}";
    private Dictionary<string, object> ControlAttributes
    {
        get
        {
            var attrs = FieldContext is null ? new Dictionary<string, object>() : new(FieldContext.ControlAttributes);
            if (AdditionalAttributes is not null)
                foreach (var pair in AdditionalAttributes) attrs[pair.Key] = pair.Value;
            if (!attrs.ContainsKey("id")) attrs["id"] = _autoId;
            if (!attrs.ContainsKey("rows")) attrs["rows"] = MinRows;
            if (MaxLength is not null) attrs["maxlength"] = MaxLength.Value;
            if (Invalid) attrs["aria-invalid"] = "true";
            return attrs;
        }
    }
    private string ControlId => Convert.ToString(ControlAttributes["id"])!;

    private ElementReference _element;
    private Microsoft.JSInterop.IJSObjectReference? _module;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!(AutoResize || Grouped))
        {
            if (_module is not null) await _module.InvokeVoidAsync("dispose", _element);
            return;
        }
        _module ??= await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>("import", "./Components/UI/Textarea/Textarea.razor.js");
        await _module.InvokeVoidAsync("init", _element);
    }
    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("dispose", _element); await _module.DisposeAsync(); }
        catch (Microsoft.JSInterop.JSDisconnectedException) { /* The circuit has already gone away. */ }
    }

}
