<nav @attributes="AdditionalAttributes" class="rax-navbar-links @Class" aria-label="@Label" data-align="@Align"><span class="rax-navbar-hover" aria-hidden="true"></span><span class="rax-navbar-current" aria-hidden="true"></span><ul>@ChildContent</ul></nav>
@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [Parameter] public string Label { get; set; } = "Main";
    [Parameter] public string Align { get; set; } = "start";
}
