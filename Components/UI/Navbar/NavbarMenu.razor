<div @attributes="AdditionalAttributes" id="@Parent?.MenuId" class="rax-navbar-menu @Class" data-state="@(Parent?.Current == true ? "open" : "closed")" inert="@(Parent?.Current != true)"><div class="rax-navbar-menu-clip"><nav class="rax-navbar-menu-body" aria-label="@Label">@ChildContent</nav></div></div>
@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [CascadingParameter] public Navbar? Parent { get; set; }
    [Parameter] public string Label { get; set; } = "Menu";
}
