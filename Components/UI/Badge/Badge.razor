@* RaxUI Badge. Source-owned: edit freely. Styled by the badge component CSS. *@
<span @attributes="AdditionalAttributes" class="@($"rax-badge {Class}")" data-variant="@Variant" data-color="@Color" data-size="@Size" data-shape="@Shape" data-rax-appearance="@Appearance">
    @if (Dot || Ping) { <span class="rax-badge-dot" data-pulse="@(Ping ? "true" : null)" aria-hidden="true"></span> }
    @ChildContent
    @if(OnRemove.HasDelegate){<button type="button" class="rax-badge-remove" aria-label="@RemoveLabel" @onclick="OnRemove"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg></button>}
</span>
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>default, flat, or glass; null inherits the surrounding theme.</summary>
    [Parameter] public string? Appearance { get; set; }
    /// <summary>Extra CSS classes.</summary>
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [Parameter] public string Variant { get; set; } = "tinted";
    /// <summary>primary, secondary, success, warning, danger, info, or neutral.</summary>
    [Parameter] public string Color { get; set; } = "primary";
    [Parameter] public string Size { get; set; } = "default";
    [Parameter] public string Shape { get; set; } = "pill";
    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter] public string RemoveLabel { get; set; } = "Remove";
    [Parameter] public bool Dot { get; set; }
    [Parameter] public bool Ping { get; set; }
}
