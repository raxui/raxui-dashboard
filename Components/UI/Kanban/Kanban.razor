@* Built-in SVG paths from Lucide (ISC). Drag behavior reuses Sortable.razor.js (ADR 019). *@
@typeparam TItem
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
<div @ref="root" data-rax-appearance="@Appearance" dir="@Direction">
    <span id="@instructionsId" class="visually-hidden">@Instructions</span>
    <div class="@($"rax-kanban {Class}")" style="@Style" data-orientation="@Orientation" data-sortable-content="@columnsId">
        @for(var c=0;c<Columns.Count;c++){
            var column=Columns[c];var titleId=$"{columnsId}-{c}";var columnOff=Disabled||!interactive||column.Disabled;
            <div @key="column.Id" class="@($"rax-kanban-column {ColumnClass}")" role="group" aria-labelledby="@titleId" data-sortable-id="@column.Id" data-sortable-zone data-disabled="@(column.Disabled?"":null)">
                <div class="rax-kanban-column-header">
                    @if(MovableColumns){<button type="button" class="rax-kanban-handle" data-sortable-handle disabled="@columnOff" aria-label="@($"{ColumnHandleLabel} {column.Title}")" aria-describedby="@instructionsId">@grip</button>}
                    @if(ColumnHeader is null){
                        <h3 id="@titleId" class="rax-kanban-column-title">@column.Title</h3>
                        <span @key="column.Items.Count" class="rax-kanban-column-count" data-over-limit="@(column.Items.Count>column.Limit?"":null)">@(column.Limit is null?column.Items.Count:$"{column.Items.Count}/{column.Limit}")</span>
                    }else{<div id="@titleId" style="display:contents">@ColumnHeader(column)</div>}
                </div>
                <div class="rax-kanban-column-content" data-sortable-content="@cardsId" data-sortable-key="@column.Id" data-orientation="@(Orientation=="horizontal"?"vertical":"horizontal")" data-empty="@(column.Items.Count==0?"":null)">
                    @foreach(var item in column.Items){
                        var id=GetId(item);var off=Disabled||!interactive||(IsDisabled?.Invoke(item)??false);
                        <div @key="id" class="@($"rax-kanban-item {ItemClass}")" data-sortable-id="@id" data-disabled="@(off?"":null)" data-handle="@(AsHandle?"":null)" tabindex="@(AsHandle&&!off?"0":null)" role="@(AsHandle?"button":null)" aria-disabled="@(off?"true":null)" aria-label="@(AsHandle?GetLabel(item):null)" aria-describedby="@(AsHandle?instructionsId:null)">
                            @if(!AsHandle){<button type="button" class="rax-kanban-handle" data-sortable-handle disabled="@off" aria-label="@($"{ItemHandleLabel} {GetLabel(item)}")" aria-describedby="@instructionsId">@grip</button>}
                            @ItemTemplate(item)
                        </div>
                    }
                    @if(column.Items.Count==0&&Empty is not null){<div class="rax-kanban-empty">@Empty</div>}
                </div>
            </div>
        }
    </div>
    <div class="visually-hidden" aria-live="assertive" aria-atomic="true" data-sortable-live="@instructionsId"></div>
</div>
@code {
    [Parameter,EditorRequired] public IReadOnlyList<KanbanTypes.Column<TItem>> Columns { get; set; } = Array.Empty<KanbanTypes.Column<TItem>>();
    [Parameter] public EventCallback<IReadOnlyList<KanbanTypes.Column<TItem>>> ColumnsChanged { get; set; }
    /// <summary>Called once a drag ends with a real change, e.g. to save it.</summary>
    [Parameter] public EventCallback<KanbanTypes.Change> Committed { get; set; }
    [Parameter,EditorRequired] public Func<TItem,string> GetId { get; set; } = default!;
    [Parameter,EditorRequired] public RenderFragment<TItem> ItemTemplate { get; set; } = default!;
    [Parameter] public Func<TItem,string> GetLabel { get; set; } = item=>Convert.ToString(item)??"";
    [Parameter] public RenderFragment<KanbanTypes.Column<TItem>>? ColumnHeader { get; set; }
    /// <summary>Shown in a column without cards; it still accepts drops.</summary>
    [Parameter] public RenderFragment? Empty { get; set; }
    [Parameter] public Func<TItem,bool>? IsDisabled { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Drag by the whole card (default) or only by its grip.</summary>
    [Parameter] public bool AsHandle { get; set; } = true;
    [Parameter] public bool MovableColumns { get; set; } = true;
    /// <summary>Columns side by side (horizontal) or stacked (vertical).</summary>
    [Parameter] public string Orientation { get; set; } = "horizontal";
    [Parameter] public string Instructions { get; set; } = "To pick up a card or column, press Space or Enter. Use the arrow keys to move it, Space or Enter to drop it, and Escape to cancel.";
    [Parameter] public string ItemHandleLabel { get; set; } = "Drag card";
    [Parameter] public string ColumnHandleLabel { get; set; } = "Drag column";
    [Parameter] public string Grabbed { get; set; } = "Picked up {item} in {column}. Position {position} of {total}.";
    [Parameter] public string Moved { get; set; } = "{item} moved to {column}, position {position} of {total}.";
    [Parameter] public string Dropped { get; set; } = "{item} dropped in {column} at position {position} of {total}.";
    [Parameter] public string Cancelled { get; set; } = "Cancelled. {item} is back where it was.";
    [Parameter] public string ColumnGrabbed { get; set; } = "Picked up {item}. Position {position} of {total}.";
    [Parameter] public string ColumnMoved { get; set; } = "{item} moved, position {position} of {total}.";
    [Parameter] public string ColumnDropped { get; set; } = "{item} dropped at position {position} of {total}.";
    [Parameter] public string? Appearance { get; set; }
    [Parameter] public string? Direction { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? ColumnClass { get; set; }
    [Parameter] public string? ItemClass { get; set; }
    private static readonly RenderFragment grip=@<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="9" cy="6" r="1.5"/><circle cx="15" cy="6" r="1.5"/><circle cx="9" cy="12" r="1.5"/><circle cx="15" cy="12" r="1.5"/><circle cx="9" cy="18" r="1.5"/><circle cx="15" cy="18" r="1.5"/></svg>;
    private readonly string instructionsId=$"rax-kanban-{Guid.NewGuid():N}";
    private string cardsId=>instructionsId+"-cards";
    private string columnsId=>instructionsId+"-columns";
    private bool interactive;
    private ElementReference root;private IJSObjectReference? module;private DotNetObjectReference<Kanban<TItem>>? self;
    protected override void OnParametersSet(){
        ArgumentNullException.ThrowIfNull(GetId);ArgumentNullException.ThrowIfNull(ItemTemplate);
        if(Orientation is not ("horizontal" or "vertical"))throw new ArgumentException("Invalid kanban orientation.");
        var ids=Columns.Select(x=>x.Id).Concat(Columns.SelectMany(x=>x.Items).Select(GetId)).ToArray();
        if(ids.Any(string.IsNullOrEmpty)||ids.Distinct(StringComparer.Ordinal).Count()!=ids.Length)throw new ArgumentException("Kanban column and card IDs must be unique and nonempty.");
    }
    protected override async Task OnAfterRenderAsync(bool firstRender){
        if(!interactive){interactive=true;StateHasChanged();return;}
        module??=await JS.InvokeAsync<IJSObjectReference>("import","./Components/UI/Sortable/Sortable.razor.js");self??=DotNetObjectReference.Create(this);
        var titles=Columns.ToDictionary(x=>x.Id,x=>x.Title);
        await module.InvokeVoidAsync("sync",root,self,new { id=cardsId,live=instructionsId,method=nameof(MoveCard),grabbed=Grabbed,moved=Moved,dropped=Dropped,cancelled=Cancelled,labels=Columns.SelectMany(x=>x.Items).ToDictionary(GetId,GetLabel),lists=titles });
        if(MovableColumns)await module.InvokeVoidAsync("sync",root,self,new { id=columnsId,live=instructionsId,method=nameof(MoveColumn),grabbed=ColumnGrabbed,moved=ColumnMoved,dropped=ColumnDropped,cancelled=Cancelled,labels=titles });
    }
    [JSInvokable] public async Task MoveCard(string id,string to,int index){
        if(Disabled)return;var source=Columns.FirstOrDefault(c=>c.Items.Any(x=>GetId(x)==id));var target=Columns.FirstOrDefault(c=>c.Id==to);
        if(source is null||target is null||target.Disabled)return;var from=source.Items.ToList();var at=from.FindIndex(x=>GetId(x)==id);var item=from[at];
        if(IsDisabled?.Invoke(item)==true)return;from.RemoveAt(at);
        var into=source==target?from:target.Items.ToList();index=Math.Clamp(index,0,into.Count);if(source==target&&index==at)return;into.Insert(index,item);
        await Commit(Columns.Select(c=>c==source?c with { Items=from }:c==target?c with { Items=into }:c).ToList(),new(id,"card",source.Id,target.Id,index));
    }
    [JSInvokable] public async Task MoveColumn(string id,string _,int index){
        if(Disabled||!MovableColumns)return;var list=Columns.ToList();var from=list.FindIndex(c=>c.Id==id);
        if(from<0||index<0||index>=list.Count||from==index||list[from].Disabled)return;
        var column=list[from];list.RemoveAt(from);list.Insert(index,column);await Commit(list,new(id,"column",id,id,index));
    }
    private async Task Commit(IReadOnlyList<KanbanTypes.Column<TItem>> next,KanbanTypes.Change change){
        Columns=next;await ColumnsChanged.InvokeAsync(next);await Committed.InvokeAsync(change);await InvokeAsync(StateHasChanged);
    }
    public async ValueTask DisposeAsync(){if(module is null)return;try{await module.InvokeVoidAsync("dispose",cardsId);await module.InvokeVoidAsync("dispose",columnsId);await module.DisposeAsync();}catch(JSDisconnectedException){}self?.Dispose();}
}
