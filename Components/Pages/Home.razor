@page "/"
@using raxui_dashboard.Services
@inject DashboardData Data

<PageTitle>@L["Overview"] · RaxUI Admin</PageTitle>

<header class="dash-page-header">
    <div>
        <h1>@L["Good morning, Noura"]</h1>
        <p>@L["Here is how your store performed over the last 12 months."]</p>
    </div>
    <Badge Color="success" Dot Ping>@L["Live"]</Badge>
</header>

<section class="dash-kpis" aria-label="@L["Overview"]">
    @foreach (var i in Enumerable.Range(0, 4))
    {
        var kpi = data?.Kpis[i];
        <Card Class="dash-kpi">
            <CardHeader>
                <CardDescription>@(kpi is null ? "" : L[kpi.Title])</CardDescription>
                <CardAction><span class="dash-kpi-icon"><Lucide Path="@KpiIcons[i]" /></span></CardAction>
                @if (kpi is null)
                {
                    <Skeleton Width="60%" Height="2rem" />
                }
                else
                {
                    <CardTitle><span class="dash-kpi-value">@FormatKpi(kpi)</span></CardTitle>
                }
            </CardHeader>
            <CardContent>
                @if (kpi is null)
                {
                    <Skeleton Height="48px" />
                }
                else
                {
                    <div class="dash-kpi-trend">
                        <Badge Color="@(kpi.Trend >= 0 ? "success" : "danger")" Size="sm">
                            <Lucide Path="@(kpi.Trend >= 0 ? Lucide.TrendUp : Lucide.TrendDown)" Class="dash-flip-rtl" />
                            <span dir="ltr">@(kpi.Trend >= 0 ? "+" : "")@kpi.Trend.ToString("0.0", L.Culture)%</span>
                        </Badge>
                        <span>@L["vs last month"]</span>
                    </div>
                    <Chart Type="sparkline" Label="@L[kpi.Title]" Labels="monthLabels" Height="48"
                           Series="@([new ChartTypes.Series(L[kpi.Title], kpi.History) { Color = KpiColors[i] }])" />
                }
            </CardContent>
        </Card>
    }
</section>

<section class="dash-grid">
    <Card Class="dash-span-8">
        <CardHeader>
            <CardTitle><h2>@L["Revenue trend"]</h2></CardTitle>
            <CardDescription>@L["Monthly revenue in thousands of dollars, compared with last year."]</CardDescription>
        </CardHeader>
        <CardContent>
            @if (data is null)
            {
                <Skeleton Height="300px" />
            }
            else
            {
                <Chart Type="area" Label="@L["Revenue trend"]" Labels="monthLabels" Series="revenueSeries" />
            }
        </CardContent>
    </Card>

    <Card Class="dash-span-4">
        <CardHeader>
            <CardTitle><h2>@L["Sales by channel"]</h2></CardTitle>
            <CardDescription>@L["Share of orders this month."]</CardDescription>
        </CardHeader>
        <CardContent>
            @if (data is null)
            {
                <Skeleton Shape="circle" Width="220px" Class="mx-auto" />
            }
            else
            {
                <Chart Type="doughnut" Label="@L["Sales by channel"]" Labels="channelLabels" Series="channelSeries" Height="300" />
            }
        </CardContent>
    </Card>

    <Card Class="dash-span-5">
        <CardHeader>
            <CardTitle><h2>@L["Orders by month"]</h2></CardTitle>
            <CardDescription>@L["New and returning customers."]</CardDescription>
        </CardHeader>
        <CardContent>
            @if (data is null)
            {
                <Skeleton Height="300px" />
            }
            else
            {
                <Chart Type="bar" Stacked Label="@L["Orders by month"]" Labels="monthLabels" Series="ordersSeries" />
            }
        </CardContent>
    </Card>

    <Card Class="dash-span-7">
        <CardHeader>
            <CardTitle><h2>@L["Recent orders"]</h2></CardTitle>
            <CardDescription>@L["The latest orders across all channels."]</CardDescription>
            <CardAction>
                <a class="dash-link" href="customers">@L["View all"] <Lucide Path="@Lucide.ArrowRight" Class="dash-flip-rtl" /></a>
            </CardAction>
        </CardHeader>
        <CardContent Class="dash-table-content">
            @if (data is null)
            {
                <SkeletonText Lines="6" LastLineWidth="80%" />
            }
            else
            {
                <Table Density="compact">
                    <TableHeader>
                        <TableRow>
                            <TableHead>@L["Order"]</TableHead>
                            <TableHead>@L["Customer"]</TableHead>
                            <TableHead Class="dash-hide-sm">@L["Channel"]</TableHead>
                            <TableHead Class="dash-hide-sm">@L["Date"]</TableHead>
                            <TableHead>@L["Status"]</TableHead>
                            <TableHead Class="dash-num">@L["Amount"]</TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var order in data.RecentOrders)
                        {
                            <TableRow @key="order.Id">
                                <TableCell><span class="dash-mono" dir="ltr">@order.Id</span></TableCell>
                                <TableCell>
                                    <span class="dash-customer">
                                        <Avatar Size="sm" Name="@order.Customer" />
                                        <span class="dash-brand">
                                            <strong>@order.Customer</strong>
                                            <small>@order.Email</small>
                                        </span>
                                    </span>
                                </TableCell>
                                <TableCell Class="dash-hide-sm">@L[order.Channel]</TableCell>
                                <TableCell Class="dash-hide-sm">@order.Date.ToString("d MMM", L.Culture)</TableCell>
                                <TableCell><Badge Color="@StatusColor(order.Status)" Dot>@L[order.Status]</Badge></TableCell>
                                <TableCell Class="dash-num"><span dir="ltr">@L.Money(order.Amount, 2)</span></TableCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            }
        </CardContent>
    </Card>
</section>

@code {
    [CascadingParameter] public Ui L { get; set; } = new(false);

    private static readonly string[] KpiIcons = [Lucide.Dollar, Lucide.Bag, Lucide.UserPlus, Lucide.Receipt];
    private static readonly string[] KpiColors = ["1", "2", "3", "4"];

    private Overview? data;

    // Data loads after the first interactive render, so prerendering shows the skeletons.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        data = await Data.GetOverviewAsync();
        StateHasChanged();
    }

    // Rebuilt each render; Chart only sends a payload to the browser when it changed.
    private string[] monthLabels => data!.Months.Select(m => m.ToString("MMM", L.Culture)).ToArray();
    private string[] channelLabels => data!.Channels.Select(c => L[c]).ToArray();
    private ChartTypes.Series[] revenueSeries =>
    [
        new(L["This year"], data!.Revenue) { Color = "1" },
        new(L["Last year"], data.RevenueLastYear) { Color = "6" },
    ];
    private ChartTypes.Series[] ordersSeries =>
    [
        new(L["New"], data!.NewCustomers) { Color = "1" },
        new(L["Returning"], data.ReturningCustomers) { Color = "2" },
    ];
    private ChartTypes.Series[] channelSeries => [new(L["Orders"], data!.ChannelShare)];

    private string FormatKpi(Kpi kpi) => kpi.Format switch
    {
        "money" => L.Money(kpi.Value),
        "money2" => L.Money(kpi.Value, 2),
        _ => kpi.Value.ToString("N0", L.Culture),
    };

    private static string StatusColor(string status) => status switch
    {
        "Paid" => "success",
        "Shipped" => "info",
        "Pending" => "warning",
        "Cancelled" => "danger",
        _ => "neutral",
    };
}
