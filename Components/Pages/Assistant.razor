@page "/assistant"
@using System.Text.Json
@using raxui_dashboard.Services
@implements IDisposable
@inject DashboardData Data

<PageTitle>@L["AI Assistant"] · RaxUI Admin</PageTitle>

<header class="dash-page-header">
    <div>
        <h1>@L["AI Assistant"]</h1>
        <p>@L["Ask about revenue, customers or tasks. Answers use the dashboard's own data."]</p>
    </div>
    <Badge Color="info" Variant="outline">@L["Demo model"]</Badge>
</header>

<Card Class="dash-chat">
    @* column-reverse keeps the newest turn in view without script. *@
    <div class="dash-chat-scroll">
        <div class="@(turns.Count == 0 ? "dash-chat-empty" : null)">
            @if (turns.Count == 0)
            {
                <span class="dash-logo dash-logo-lg"><Lucide Path="@Lucide.Sparkles" /></span>
                <h2>@L["How can I help with your store today?"]</h2>
                <AISuggestions Suggestions="Suggestions" OnSelect="Ask" Class="justify-content-center" />
            }
            else
            {
                <AIConversation>
                    @foreach (var turn in turns)
                    {
                        <AIMessage @key="turn.Id" From="user">@turn.Prompt</AIMessage>
                        <AIMessage @key="-turn.Id" From="assistant">
                            @if (turn.Thinking || turn.Reasoning.Length > 0)
                            {
                                <AIReasoning Streaming="turn.Thinking" ThinkingLabel="@L["Thinking…"]" DoneLabel="@L["Thought for {s}s"]">@turn.Reasoning</AIReasoning>
                            }
                            @if (turn.Tool is not null)
                            {
                                <AIToolCall Name="@turn.Answer.Tool" Status="@turn.Tool" Input="@turn.Answer.Input" Output="@turn.Output" Error="@L["Stopped"]"
                                            PendingLabel="@L["Waiting"]" RunningLabel="@L["Running"]" CompletedLabel="@L["Completed"]" ErrorLabel="@L["Failed"]"
                                            InputLabel="@L["Input"]" OutputLabel="@L["Output"]">
                                    <Title>@L["Querying dashboard data"]</Title>
                                </AIToolCall>
                            }
                            @if (turn.Streaming || turn.Text.Length > 0)
                            {
                                <AIResponse Markdown Streaming="turn.Streaming" Text="@turn.Text" CopyLabel="@L["Copy"]" CopiedLabel="@L["Copied"]" />
                            }
                            @if (turn.Stopped)
                            {
                                <div class="dash-status">@L["Stopped."]</div>
                            }
                            @if (turn.Done)
                            {
                                <AIActions CopyText="@turn.Text"
                                           OnRegenerate="@(turn == turns[^1] && status == "ready" ? EventCallback.Factory.Create(this, () => Ask(turn.Prompt)) : default)"
                                           Feedback="@turn.Feedback" FeedbackChanged="@(value => turn.Feedback = value)"
                                           CopyLabel="@L["Copy"]" CopiedLabel="@L["Copied"]" RegenerateLabel="@L["Regenerate"]"
                                           GoodLabel="@L["Good response"]" BadLabel="@L["Bad response"]" />
                            }
                        </AIMessage>
                    }
                </AIConversation>
            }
        </div>
    </div>
    <div class="dash-chat-input">
        <AIPromptInput Status="@status" OnSubmit="Ask" OnStop="Stop" Placeholder="@L["Ask about your store…"]"
                       Label="@L["Message"]" SendLabel="@L["Send"]" StopLabel="@L["Stop"]" />
    </div>
</Card>

@code {
    [CascadingParameter] public Ui L { get; set; } = new(false);

    private sealed record Answer(string Tool, string Input, string Output, string Reasoning, string Text);
    private sealed class Turn
    {
        public int Id; public string Prompt = ""; public Answer Answer = default!;
        public string Reasoning = ""; public bool Thinking; public string? Tool; public string? Output;
        public string Text = ""; public bool Streaming, Done, Stopped; public string? Feedback;
    }

    private readonly List<Turn> turns = [];
    private string status = "ready";
    private int nextId = 1;
    private CancellationTokenSource? run;

    private string[] Suggestions =>
        [L["How did revenue do this quarter?"], L["Who are my top customers?"], L["What is overdue on the task board?"]];

    // shortcut: a keyword router with canned, data-backed answers stands in for a model; swap in a real chat client later.
    private async Task<Answer> AnswerFor(string prompt)
    {
        var p = prompt.ToLowerInvariant();
        var arabic = L.Arabic || prompt.Any(c => c is >= '؀' and <= 'ۿ');
        if (p.Contains("customer") || p.Contains("عميل") || p.Contains("عملا")) return Customers(await Data.GetCustomersAsync(), arabic);
        if (p.Contains("task") || p.Contains("overdue") || p.Contains("مهام") || p.Contains("متأخر")) return Tasks(arabic);
        return Revenue(await Data.GetOverviewAsync(), arabic);
    }

    private static string Json(object value) => JsonSerializer.Serialize(value, new JsonSerializerOptions
    {
        WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
    });

    private static Answer Revenue(Overview o, bool ar)
    {
        var q = o.Revenue.TakeLast(3).Sum();
        var prev = o.Revenue.SkipLast(3).TakeLast(3).Sum();
        var yoy = o.RevenueLastYear.TakeLast(3).Sum();
        var rows = string.Join("\n", Enumerable.Range(9, 3).Select(i =>
            $"| {o.Months[i].ToString("MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo(ar ? "ar-EG" : "en-US"))} | ${o.Revenue[i]:0.0}k | ${o.RevenueLastYear[i]:0.0}k |"));
        var growth = (q - prev) / prev * 100;
        var vsYear = (q - yoy) / yoy * 100;
        var text = ar
            ? $"حققت الإيرادات **${q:0.0}k** في آخر ثلاثة أشهر، بزيادة **{growth:0.0}%** عن الربع السابق و**{vsYear:0.0}%** عن نفس الفترة من العام الماضي.\n\n| الشهر | هذا العام | العام الماضي |\n|---|--:|--:|\n{rows}\n\nأبرز الملاحظات:\n\n- أكتوبر هو أفضل شهر في السنة.\n- نمو العملاء الجدد يقود معظم الزيادة.\n- راقب متوسط قيمة الطلب: ارتفاعه أبطأ من الإيرادات."
            : $"Revenue reached **${q:0.0}k** over the last three months, up **{growth:0.0}%** on the previous quarter and **{vsYear:0.0}%** year over year.\n\n| Month | This year | Last year |\n|---|--:|--:|\n{rows}\n\nWhat stands out:\n\n- October was the best month of the year.\n- New customers drive most of the growth.\n- Watch average order value: it is rising slower than revenue.";
        return new("query_revenue", Json(new { range = "last_3_months", compare = new[] { "previous_period", "last_year" } }),
            Json(new { total_k = Math.Round(q, 1), previous_k = Math.Round(prev, 1), last_year_k = Math.Round(yoy, 1) }),
            ar ? "المستخدم يسأل عن إيرادات الربع.\nسأجمع آخر ثلاثة أشهر وأقارنها بالربع السابق والعام الماضي." : "The user asks about quarterly revenue.\nI will sum the last three months and compare with the previous quarter and last year.",
            text);
    }

    private static Answer Customers(IReadOnlyList<Customer> all, bool ar)
    {
        var top = all.OrderByDescending(c => c.Spent).Take(5).ToArray();
        var rows = string.Join("\n", top.Select((c, i) => $"| {i + 1} | {c.Name} | {c.Plan} | {c.Orders} | ${c.Spent:N0} |"));
        var share = top.Sum(c => c.Spent) / all.Sum(c => c.Spent) * 100;
        var text = ar
            ? $"أعلى خمسة عملاء من حيث الإنفاق يمثلون **{share:0}%** من إجمالي قيمة العملاء:\n\n| # | العميل | الخطة | الطلبات | الإنفاق |\n|--:|---|---|--:|--:|\n{rows}\n\nاقتراح: أرسل لهم عرض ولاء قبل **الجمعة البيضاء**."
            : $"Your five biggest customers account for **{share:0}%** of lifetime value:\n\n| # | Customer | Plan | Orders | Spent |\n|--:|---|---|--:|--:|\n{rows}\n\nSuggestion: send them a loyalty offer before **Black Friday**.";
        return new("query_customers", Json(new { sort = "spent_desc", limit = 5 }),
            Json(new { results = top.Length, top = top[0].Name }),
            ar ? "المستخدم يريد أفضل العملاء.\nسأرتّب العملاء حسب الإنفاق وآخذ أول خمسة." : "The user wants the top customers.\nI will sort customers by amount spent and take five.",
            text);
    }

    private Answer Tasks(bool ar)
    {
        var today = new DateOnly(2026, 11, 5);
        var open = Data.GetTaskBoard().Where(c => c.Column != "done").SelectMany(c => c.Cards.Select(card => (c.Column, card))).ToArray();
        var soon = open.Where(x => x.card.Due is { } d && d <= today.AddDays(7)).OrderBy(x => x.card.Due).ToArray();
        var list = string.Join("\n", soon.Select(x => $"- [ ] **{x.card.Title}** · {x.card.Assignee} · {x.card.Due:yyyy-MM-dd}"));
        var text = ar
            ? $"لا توجد مهام متأخرة اليوم، لكن **{soon.Length}** مهام تستحق خلال الأيام السبعة القادمة:\n\n{list}\n\nعمود **قيد التنفيذ** فيه {open.Count(x => x.Column == "doing")} من 3 مهام، فهناك مكان لمهمة واحدة أخرى."
            : $"Nothing is overdue today, but **{soon.Length}** tasks are due in the next seven days:\n\n{list}\n\n**In progress** holds {open.Count(x => x.Column == "doing")} of 3 tasks, so there is room for one more.";
        return new("query_tasks", Json(new { status = "open", due_within_days = 7 }),
            Json(new { open = open.Length, due_soon = soon.Length }),
            ar ? "المستخدم يسأل عن المهام المتأخرة.\nسأفحص المهام المفتوحة وتواريخ استحقاقها." : "The user asks what is overdue.\nI will check open tasks and their due dates.",
            text);
    }

    // Simulated model: think line by line, call a tool, then stream the answer word by word.
    private async Task Ask(string prompt)
    {
        run?.Cancel();
        run = new();
        var token = run.Token;
        var turn = new Turn { Id = nextId++, Prompt = prompt, Answer = await AnswerFor(prompt) };
        turns.Add(turn);
        status = "submitted";
        async Task Step(int ms, Action change) { await Task.Delay(ms, token); change(); StateHasChanged(); }
        try
        {
            await Step(400, () => { status = "streaming"; turn.Thinking = true; });
            var lines = turn.Answer.Reasoning.Split('\n');
            for (var i = 0; i < lines.Length; i++) { var line = lines[i]; var first = i == 0; await Step(500, () => turn.Reasoning += (first ? "" : "\n") + line); }
            await Step(400, () => { turn.Thinking = false; turn.Tool = "running"; });
            await Step(900, () => { turn.Tool = "completed"; turn.Output = turn.Answer.Output; });
            await Step(250, () => turn.Streaming = true);
            var words = turn.Answer.Text.Split(' ');
            for (var i = 0; i < words.Length; i++) { var word = words[i]; var first = i == 0; await Step(35, () => turn.Text += (first ? "" : " ") + word); }
            await Step(150, () => Finish(turn, false));
        }
        catch (TaskCanceledException) { }
    }

    private void Finish(Turn turn, bool stopped)
    {
        turn.Thinking = false; turn.Streaming = false; turn.Done = true; turn.Stopped = stopped;
        if (turn.Tool == "running") turn.Tool = "error";
        status = "ready";
    }

    private void Stop() { run?.Cancel(); if (turns.Count > 0) Finish(turns[^1], true); }

    public void Dispose() => run?.Cancel();
}
