@page "/tasks"
@using System.ComponentModel.DataAnnotations
@using raxui_dashboard.Services
@inject DashboardData Data

<PageTitle>@L["Tasks"] · RaxUI Admin</PageTitle>

<header class="dash-page-header">
    <div>
        <h1>@L["Tasks"]</h1>
        <p>@L["Drag cards between columns with the mouse, touch or keyboard."]</p>
    </div>
    <Button Size="sm" OnClick="Add"><Lucide Path="@Lucide.Plus" /> @L["New task"]</Button>
</header>

<Dialog @bind-Open="adding" Title="@L["New task"]" Description="@L["Add a card to the board. You can drag it later."]" CloseLabel="@L["Close"]">
    <ChildContent>
        <EditForm id="add-task" Context="form" Model="draft" OnValidSubmit="SaveTask" class="dash-dialog-form">
            <DataAnnotationsValidator />
            <Field Id="task-title" For="@(() => draft.Title)" Required="true">
                <FieldLabel>@L["Title"]</FieldLabel>
                <Input @bind-Value="draft.Title" autocomplete="off" placeholder="@L["e.g. Prepare the holiday campaign"]" />
                <FieldError />
            </Field>
            <div class="dash-dialog-row">
                <Field Id="task-column" For="@(() => draft.Column)">
                    <FieldLabel>@L["Column"]</FieldLabel>
                    <Select TValue="string" @bind-Value="draft.Column">
                        @foreach (var (id, meta) in Meta.Where(m => m.Key != "done")) { <option value="@id">@L[meta.Title]</option> }
                    </Select>
                </Field>
                <Field Id="task-priority" For="@(() => draft.Priority)">
                    <FieldLabel>@L["Priority"]</FieldLabel>
                    <Select TValue="string" @bind-Value="draft.Priority">
                        @foreach (var p in Priorities) { <option value="@p">@L[p]</option> }
                    </Select>
                </Field>
            </div>
            <div class="dash-dialog-row">
                <Field Id="task-tag" For="@(() => draft.Tag)">
                    <FieldLabel>@L["Tag"]</FieldLabel>
                    <Select TValue="string" @bind-Value="draft.Tag">
                        @foreach (var t in Tags) { <option value="@t">@L[t]</option> }
                    </Select>
                </Field>
                <Field Id="task-assignee" For="@(() => draft.Assignee)">
                    <FieldLabel>@L["Assignee"]</FieldLabel>
                    <Select TValue="string" @bind-Value="draft.Assignee">
                        @foreach (var name in Team) { <option value="@name">@name</option> }
                    </Select>
                </Field>
            </div>
            <Field Id="task-due" For="@(() => draft.Due)" Optional>
                <FieldLabel OptionalText="@L["(Optional)"]">@L["Due date"]</FieldLabel>
                <DatePicker @bind-Value="draft.Due" Culture="L.Culture" Today="Today" Min="Today" Clearable Placeholder="@L["Pick a date"]" />
                <FieldError />
            </Field>
        </EditForm>
    </ChildContent>
    <Footer>
        <Button Variant="outline" OnClick="() => adding = false">@L["Cancel"]</Button>
        <Button Type="submit" form="add-task">@L["Add task"]</Button>
    </Footer>
</Dialog>

<Kanban TItem="TaskCard" Columns="Board" ColumnsChanged="cols => columns = cols" GetId="c => c.Id" GetLabel="c => c.Title"
        Committed="Log" Class="dash-board" Direction="@(L.Arabic ? "rtl" : "ltr")"
        Instructions="@L["To pick up a card or column, press Space or Enter. Use the arrow keys to move it, Space or Enter to drop it, and Escape to cancel."]"
        ItemHandleLabel="@L["Drag card"]" ColumnHandleLabel="@L["Drag column"]"
        Grabbed="@L["Picked up {item} in {column}. Position {position} of {total}."]"
        Moved="@L["{item} moved to {column}, position {position} of {total}."]"
        Dropped="@L["{item} dropped in {column} at position {position} of {total}."]"
        Cancelled="@L["Cancelled. {item} is back where it was."]">
    <ColumnHeader Context="column">
        <span class="dash-dot" data-column="@column.Id" aria-hidden="true"></span>
        <h2 class="rax-kanban-column-title">@column.Title</h2>
        <span @key="column.Items.Count" class="rax-kanban-column-count" data-over-limit="@(column.Items.Count > column.Limit ? "" : null)">
            @(column.Limit is null ? column.Items.Count : $"{column.Items.Count}/{column.Limit}")
        </span>
    </ColumnHeader>
    <ItemTemplate Context="card">
        <div class="dash-task">
            <span class="dash-task-title">@card.Title</span>
            <div class="dash-task-meta">
                <Badge Size="sm" Color="@TagColor(card.Tag)">@L[card.Tag]</Badge>
                <Badge Size="sm" Variant="outline" Color="@PriorityColor(card.Priority)">@L[card.Priority]</Badge>
            </div>
            <div class="dash-task-foot">
                @if (card.Due is { } due)
                {
                    <span class="dash-task-due" data-overdue="@(due < Today && !IsDone(card) ? "" : null)">
                        <Lucide Path="@Lucide.Calendar" /> @due.ToString("d MMM", L.Culture)
                    </span>
                }
                @if (card.Comments > 0)
                {
                    <span class="dash-task-due"><Lucide Path="@Lucide.Message" /> @card.Comments</span>
                }
                <Avatar Size="xs" Name="@card.Assignee" Class="dash-task-avatar" title="@card.Assignee" />
            </div>
        </div>
    </ItemTemplate>
    <Empty>@L["Drop cards here"]</Empty>
</Kanban>
<output class="dash-status" role="status">@log</output>

@code {
    [CascadingParameter] public Ui L { get; set; } = new(false);

    private static readonly DateOnly Today = new(2026, 11, 5);
    private static readonly Dictionary<string, (string Title, int? Limit)> Meta = new()
    {
        ["backlog"] = ("Backlog", null), ["todo"] = ("To do", null), ["doing"] = ("In progress", 3), ["done"] = ("Done", null),
    };

    private IReadOnlyList<KanbanTypes.Column<TaskCard>> columns = [];
    private string log = "";
    private int next = 11;

    protected override void OnInitialized() =>
        columns = Data.GetTaskBoard().Select(c => new KanbanTypes.Column<TaskCard>(c.Column, Meta[c.Column].Title, c.Cards) { Limit = Meta[c.Column].Limit }).ToArray();

    // Column titles follow the UI language; the board state keeps the English title.
    private IReadOnlyList<KanbanTypes.Column<TaskCard>> Board => columns.Select(c => c with { Title = L[Meta[c.Id].Title] }).ToArray();

    private bool IsDone(TaskCard card) => columns.First(c => c.Id == "done").Items.Contains(card);

    private static readonly string[] Tags = ["Design", "Engineering", "Marketing", "Finance", "Operations", "Content", "Support", "Analytics"];
    private static readonly string[] Priorities = ["Low", "Medium", "High"];
    private static readonly string[] Team =
        ["Noura Al-Qahtani", "Layla Nasser", "Liam Carter", "Omar Haddad", "Sofia Martins", "Yusuf Rahman", "Emma Schmidt", "Daniel Kim"];

    private bool adding;
    private TaskDraft draft = new(new(false));

    // Error texts come from the cascaded Ui so they follow the interface language.
    private sealed class TaskDraft(Ui l) : IValidatableObject
    {
        public string Title { get; set; } = "";
        public string Column { get; set; } = "todo";
        public string Tag { get; set; } = "Operations";
        public string Priority { get; set; } = "Medium";
        public string Assignee { get; set; } = "Noura Al-Qahtani";
        public DateOnly? Due { get; set; } = Today.AddDays(7);

        public IEnumerable<ValidationResult> Validate(ValidationContext context)
        {
            if (string.IsNullOrWhiteSpace(Title)) yield return new(l["Give the task a title."], [nameof(Title)]);
            else if (Title.Trim().Length > 80) yield return new(l["Keep the title under 80 characters."], [nameof(Title)]);
        }
    }

    private void Add()
    {
        draft = new(L);
        adding = true;
    }

    private void SaveTask()
    {
        var card = new TaskCard($"t{next++}", draft.Title.Trim(), draft.Tag, draft.Priority, draft.Assignee, draft.Due, 0);
        columns = columns.Select(c => c.Id == draft.Column ? c with { Items = [card, .. c.Items] } : c).ToArray();
        adding = false;
        log = $"{card.Title} → {L[Meta[draft.Column].Title]}";
    }

    private void Log(KanbanTypes.Change change)
    {
        var name = change.Type == "card"
            ? columns.SelectMany(c => c.Items).FirstOrDefault(c => c.Id == change.Id)?.Title ?? change.Id
            : L[Meta[change.Id].Title];
        log = $"{name} → {L[Meta[change.To].Title]}";
    }

    private static string TagColor(string tag) => tag switch
    {
        "Design" => "primary", "Engineering" => "info", "Marketing" => "warning", "Finance" => "success", _ => "neutral",
    };

    private static string PriorityColor(string p) => p switch { "High" => "danger", "Medium" => "warning", _ => "neutral" };
}
