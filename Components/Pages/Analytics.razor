@page "/dashboard/analytics"
@using raxui_dashboard.Services
@implements IDisposable
@inject DashboardData Data

<PageTitle>@L["Analytics"] · RaxUI Admin</PageTitle>

<header class="dash-page-header dash-page-header-end">
    <div>
        <h1>@L["Hello, Noura"]</h1>
        <p>@L["Traffic, engagement and conversion for the store in one view."]</p>
    </div>
    <div class="dash-filters">
        <Select TValue="string" Value="@range" ValueChanged="SetRange" ValueExpression="() => range" Size="sm" aria-label="@L["Period"]" Class="dash-filter">
            @foreach (var r in DashboardData.AnalyticsRanges) { <option value="@r">@L[RangeName(r)]</option> }
        </Select>
    </div>
</header>

<Tabs Items="TabItems" @bind-Value="tab" Label="@L["Analytics"]" Class="dash-tabs">
    <Panel Context="value">
        @if (view is null)
        {
            <section class="dash-grid" aria-busy="true">
                <Skeleton Class="dash-span-12" Height="8rem" />
                <Skeleton Class="dash-span-7" Height="20rem" />
                <Skeleton Class="dash-span-5" Height="20rem" />
            </section>
        }
        else
        {
            <section class="dash-grid">
                @switch (value)
                {
                    case "overview":
                        <Card Class="dash-span-12 dash-kpi-grid dash-kpi-grid-5">
                            @foreach (var kpi in view.Kpis) { <KpiStat Kpi="kpi" Comparison="@L[PreviousName(view.Range)]" /> }
                        </Card>

                        <Card Class="dash-span-7">
                            <CardHeader>
                                <CardDescription>@L["Traffic trend"]</CardDescription>
                                <CardTitle><span class="dash-headline"><bdi>@view.Sessions.Sum().ToString("N0", L.Culture)</bdi> <small>@L["sessions"]</small></span></CardTitle>
                            </CardHeader>
                            <CardContent>
                                <Chart Type="line" Label="@L["Traffic trend"]" Labels="BucketLabels" Height="250"
                                       Series="@([new ChartTypes.Series(L["Sessions"], view.Sessions) { Color = "1" },
                                                  new ChartTypes.Series(L["Unique visitors"], view.Visitors) { Color = "2" }])" />
                            </CardContent>
                        </Card>

                        <Card Class="dash-span-5">
                            <CardHeader>
                                <CardDescription>@L["Realtime visitors"]</CardDescription>
                                <CardTitle><span class="dash-headline"><bdi>@active</bdi> <small>@L["in the last minute"]</small></span></CardTitle>
                                <CardAction><Badge Color="success" Dot Ping>@L["Live"]</Badge></CardAction>
                            </CardHeader>
                            <CardContent>
                                <Chart Type="sparkline" Label="@L["Realtime visitors"]" Labels="LiveLabels" Height="64"
                                       Series="@([new ChartTypes.Series(L["Visitors"], live) { Color = "3" }])" />
                                <ul class="dash-list dash-gap">
                                    @foreach (var c in view.Countries.Take(4))
                                    {
                                        <li>
                                            <span class="dash-country"><span class="dash-code">@c.Code</span> @L[c.Name]</span>
                                            <bdi class="dash-list-value">@((int)Math.Round(active * c.Visitors / view.Countries.Sum(x => x.Visitors)))</bdi>
                                        </li>
                                    }
                                </ul>
                            </CardContent>
                        </Card>

                        <Card Class="dash-span-7">
                            <CardHeader>
                                <CardDescription>@L["Page performance"]</CardDescription>
                                <CardTitle><span class="dash-headline"><bdi>@view.Kpis[2].Value.ToString("N0", L.Culture)</bdi> <small>@L["pageviews"]</small></span></CardTitle>
                            </CardHeader>
                            <CardContent Class="dash-table-content">
                                <PagesTable Pages="view.Pages" />
                            </CardContent>
                        </Card>

                        <Card Class="dash-span-5">
                            <CardHeader>
                                <CardDescription>@L["Traffic sources"]</CardDescription>
                            </CardHeader>
                            <CardContent>
                                <Tabs Items="SourceTabs" @bind-Value="sourceTab" Variant="underline" Label="@L["Traffic sources"]">
                                    <Panel Context="source">
                                        @{
                                            var rows = source switch
                                            {
                                                "campaigns" => view.Campaigns.Select(c => (c.Name, c.Visits)).ToArray(),
                                                "referrers" => view.Referrers.ToArray(),
                                                _ => view.Sources.ToArray(),
                                            };
                                            var top = rows.Max(r => r.Item2);
                                        }
                                        <ul class="dash-funnel dash-gap">
                                            @foreach (var (name, visits) in rows)
                                            {
                                                <li>
                                                    <div class="dash-funnel-head">
                                                        <span>@(source == "referrers" ? name : L[name])</span>
                                                        <bdi class="dash-list-value">@visits.ToString("N0", L.Culture)</bdi>
                                                    </div>
                                                    <Progress Value="visits" Max="top" Size="sm" Color="info" AccessibleLabel="@($"{name}: {visits:N0}")" />
                                                </li>
                                            }
                                        </ul>
                                    </Panel>
                                </Tabs>
                            </CardContent>
                        </Card>
                        break;

                    case "audience":
                        <Card Class="dash-span-8">
                            <CardHeader>
                                <CardDescription>@L["New and returning visitors"]</CardDescription>
                                <CardTitle><span class="dash-headline"><bdi>@Percent(view.ReturningVisitors.Sum(), view.Visitors.Sum())</bdi> <small>@L["returning"]</small></span></CardTitle>
                            </CardHeader>
                            <CardContent>
                                <Chart Type="bar" Stacked Label="@L["New and returning visitors"]" Labels="BucketLabels" Height="260"
                                       Series="@([new ChartTypes.Series(L["New"], view.NewVisitors) { Color = "1" },
                                                  new ChartTypes.Series(L["Returning"], view.ReturningVisitors) { Color = "2" }])" />
                            </CardContent>
                        </Card>

                        <Card Class="dash-span-4">
                            <CardHeader>
                                <CardDescription>@L["Devices"]</CardDescription>
                                <CardTitle><span class="dash-headline">@L[view.Devices[0].Name] <small><bdi>@view.Devices[0].Share%</bdi></small></span></CardTitle>
                            </CardHeader>
                            <CardContent>
                                <SplitBar Parts="@view.Devices.Select(d => (L[d.Name], d.Share)).ToArray()" />
                                <div class="dash-counters">
                                    @foreach (var d in view.Devices)
                                    {
                                        <div><span>@L[d.Name]</span><strong><bdi>@((view.Kpis[0].Value * d.Share / 100).ToString("N0", L.Culture))</bdi></strong></div>
                                    }
                                </div>
                            </CardContent>
                        </Card>

                        <Card Class="dash-span-12">
                            <CardHeader>
                                <CardDescription>@L["Top countries"]</CardDescription>
                                <CardTitle><span class="dash-headline">@L[view.Countries[0].Name] <small><bdi>@Percent(view.Countries[0].Visitors, view.Kpis[0].Value)</bdi> @L["of visitors"]</small></span></CardTitle>
                            </CardHeader>
                            <CardContent>
                                <ul class="dash-funnel dash-columns">
                                    @foreach (var c in view.Countries)
                                    {
                                        <li>
                                            <div class="dash-funnel-head">
                                                <span class="dash-country"><span class="dash-code">@c.Code</span> @L[c.Name]</span>
                                                <bdi class="dash-list-value">@c.Visitors.ToString("N0", L.Culture)</bdi>
                                            </div>
                                            <Progress Value="c.Visitors" Max="view.Countries[0].Visitors" Size="sm" AccessibleLabel="@($"{L[c.Name]}: {c.Visitors:N0}")" />
                                        </li>
                                    }
                                </ul>
                            </CardContent>
                        </Card>
                        break;

                    case "acquisition":
                        <Card Class="dash-span-7">
                            <CardHeader>
                                <CardDescription>@L["Sessions by channel"]</CardDescription>
                                <CardTitle><span class="dash-headline">@L[view.Sources[0].Name] <small><bdi>@Percent(view.Sources[0].Visits, view.Sources.Sum(s => s.Visits))</bdi></small></span></CardTitle>
                            </CardHeader>
                            <CardContent>
                                <Chart Type="bar" Horizontal Grid="false" Legend="false" Label="@L["Sessions by channel"]" Height="240"
                                       Labels="@view.Sources.Select(s => L[s.Name]).ToArray()"
                                       Series="@([new ChartTypes.Series(L["Sessions"], view.Sources.Select(s => s.Visits).ToArray()) { Color = "2" }])" />
                            </CardContent>
                        </Card>

                        <Card Class="dash-span-5">
                            <CardHeader>
                                <CardDescription>@L["Top referrers"]</CardDescription>
                                <CardTitle><span class="dash-headline">@view.Referrers[0].Name</span></CardTitle>
                            </CardHeader>
                            <CardContent>
                                <ul class="dash-funnel">
                                    @foreach (var r in view.Referrers)
                                    {
                                        <li>
                                            <div class="dash-funnel-head"><span>@r.Name</span><bdi class="dash-list-value">@r.Visits.ToString("N0", L.Culture)</bdi></div>
                                            <Progress Value="r.Visits" Max="view.Referrers[0].Visits" Size="sm" Color="info" AccessibleLabel="@($"{r.Name}: {r.Visits:N0}")" />
                                        </li>
                                    }
                                </ul>
                            </CardContent>
                        </Card>

                        <Card Class="dash-span-12">
                            <CardHeader><CardDescription>@L["Campaigns"]</CardDescription></CardHeader>
                            <CardContent Class="dash-table-content">
                                <Table Density="compact">
                                    <TableHeader>
                                        <TableRow>
                                            <TableHead>@L["Campaign"]</TableHead>
                                            <TableHead Class="dash-num">@L["Sessions"]</TableHead>
                                            <TableHead Class="dash-num">@L["Conversion rate"]</TableHead>
                                            <TableHead>@L["vs store average"]</TableHead>
                                        </TableRow>
                                    </TableHeader>
                                    <TableBody>
                                        @foreach (var c in view.Campaigns.OrderByDescending(c => c.Conversion))
                                        {
                                            var diff = c.Conversion - view.Kpis[4].Value;
                                            <TableRow @key="c.Name">
                                                <TableCell><strong>@L[c.Name]</strong></TableCell>
                                                <TableCell Class="dash-num"><bdi>@c.Visits.ToString("N0", L.Culture)</bdi></TableCell>
                                                <TableCell Class="dash-num"><bdi>@c.Conversion.ToString("0.0", L.Culture)%</bdi></TableCell>
                                                <TableCell>
                                                    <Badge Size="sm" Color="@(diff >= 0 ? "success" : "danger")">
                                                        <bdi>@(diff >= 0 ? "+" : "")@diff.ToString("0.0", L.Culture) pt</bdi>
                                                    </Badge>
                                                </TableCell>
                                            </TableRow>
                                        }
                                    </TableBody>
                                </Table>
                            </CardContent>
                        </Card>
                        break;

                    case "engagement":
                        <Card Class="dash-span-8">
                            <CardHeader>
                                <CardDescription>@L["Average engagement time"]</CardDescription>
                                <CardTitle><span class="dash-headline"><bdi>@Duration((int)view.EngagementSeconds.Average())</bdi> <small>@L["per session"]</small></span></CardTitle>
                            </CardHeader>
                            <CardContent>
                                <Chart Type="area" Legend="false" Label="@L["Average engagement time"]" Labels="BucketLabels" Height="240"
                                       Series="@([new ChartTypes.Series(L["Seconds"], view.EngagementSeconds) { Color = "3" }])" />
                            </CardContent>
                        </Card>

                        <Card Class="dash-span-4">
                            <CardHeader><CardDescription>@L["Engagement"]</CardDescription></CardHeader>
                            <CardContent>
                                <div class="dash-aside">
                                    <div>
                                        <span class="dash-kpi-stat-label">@L["Engagement rate"]</span>
                                        <strong class="dash-aside-value"><bdi>@view.Kpis[3].Value.ToString("0.0", L.Culture)%</bdi></strong>
                                        <Progress Value="view.Kpis[3].Value" Size="sm" Color="success" AccessibleLabel="@L["Engagement rate"]" />
                                    </div>
                                    <div>
                                        <span class="dash-kpi-stat-label">@L["Pages per session"]</span>
                                        <strong class="dash-aside-value"><bdi>@((view.Kpis[2].Value / view.Kpis[1].Value).ToString("0.0", L.Culture))</bdi></strong>
                                    </div>
                                    <div>
                                        <span class="dash-kpi-stat-label">@L["Bounce rate"]</span>
                                        <strong class="dash-aside-value"><bdi>@((100 - view.Kpis[3].Value).ToString("0.0", L.Culture))%</bdi></strong>
                                    </div>
                                </div>
                            </CardContent>
                        </Card>

                        <Card Class="dash-span-12">
                            <CardHeader><CardDescription>@L["Most engaging pages"]</CardDescription></CardHeader>
                            <CardContent Class="dash-table-content">
                                <PagesTable Pages="@view.Pages.OrderByDescending(p => p.AvgSeconds).ToArray()" />
                            </CardContent>
                        </Card>
                        break;

                    default:
                        <Card Class="dash-span-5">
                            <CardHeader>
                                <CardDescription>@L["Checkout funnel"]</CardDescription>
                                <CardTitle><span class="dash-headline"><bdi>@view.Kpis[4].Value.ToString("0.00", L.Culture)%</bdi> <small>@L["of sessions purchase"]</small></span></CardTitle>
                            </CardHeader>
                            <CardContent>
                                <ol class="dash-funnel">
                                    @for (var i = 0; i < view.Funnel.Count; i++)
                                    {
                                        var step = view.Funnel[i];
                                        var drop = i == 0 ? (double?)null : 100 - step.Count / view.Funnel[i - 1].Count * 100;
                                        <li>
                                            <div class="dash-funnel-head">
                                                <span>@L[step.Step]</span>
                                                <span>
                                                    <bdi class="dash-list-value">@step.Count.ToString("N0", L.Culture)</bdi>
                                                    @if (drop is { } d) { <span class="dash-muted dash-small"> · <bdi>−@d.ToString("0", L.Culture)%</bdi></span> }
                                                </span>
                                            </div>
                                            <Progress Value="step.Count" Max="view.Funnel[0].Count" Color="@(i == view.Funnel.Count - 1 ? "success" : "primary")"
                                                      AccessibleLabel="@($"{L[step.Step]}: {step.Count:N0}")" />
                                        </li>
                                    }
                                </ol>
                            </CardContent>
                        </Card>

                        <Card Class="dash-span-7">
                            <CardHeader>
                                <CardDescription>@L["Conversion rate"]</CardDescription>
                                <CardTitle>
                                    <span class="dash-headline"><bdi>@view.Kpis[4].Value.ToString("0.00", L.Culture)%</bdi></span>
                                </CardTitle>
                                <CardAction>
                                    <Badge Size="sm" Color="@(view.Kpis[4].Good ? "success" : "danger")">
                                        <bdi>@(view.Kpis[4].Change >= 0 ? "+" : "")@view.Kpis[4].Change.ToString("0.0", L.Culture)%</bdi>
                                    </Badge>
                                </CardAction>
                            </CardHeader>
                            <CardContent>
                                <Chart Type="line" Legend="false" Label="@L["Conversion rate"]" Labels="BucketLabels" Height="260"
                                       Series="@([new ChartTypes.Series(L["Conversion rate"], view.ConversionRate) { Color = "1" }])" />
                            </CardContent>
                        </Card>
                        break;
                }
            </section>
        }
    </Panel>
</Tabs>

@code {
    [CascadingParameter] public Ui L { get; set; } = new(false);

    private string range = "30d", tab = "overview", sourceTab = "sources";
    private AnalyticsView? view;

    // Realtime: a reading every 3 seconds, the last 20 kept for the sparkline.
    private readonly List<double> live = [];
    private int active;
    private readonly CancellationTokenSource lifetime = new();

    private Tabs.Item[] TabItems =>
    [
        new("overview", L["Overview"]), new("audience", L["Audience"]), new("acquisition", L["Acquisition"]),
        new("engagement", L["Engagement"]), new("conversions", L["Conversions"]),
    ];
    private Tabs.Item[] SourceTabs => [new("sources", L["Sources"]), new("campaigns", L["Campaigns"]), new("referrers", L["Referrers"])];

    protected override void OnInitialized()
    {
        var now = DateTime.UtcNow;
        for (var i = 19; i >= 0; i--) live.Add(DashboardData.ActiveVisitors(now.AddSeconds(-3 * i)));
        active = (int)live[^1];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Load();
        _ = Tick(lifetime.Token);
    }

    private async Task Tick(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                active = DashboardData.ActiveVisitors(DateTime.UtcNow);
                live.Add(active);
                if (live.Count > 20) live.RemoveAt(0);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        lifetime.Cancel();
        lifetime.Dispose();
    }

    private async Task Load()
    {
        view = await Data.GetAnalyticsAsync(range);
        StateHasChanged();
    }

    private Task SetRange(string value) { range = value; return Load(); }

    private string[] LiveLabels => live.Select((_, i) => $"-{(live.Count - 1 - i) * 3}s").ToArray();
    private string[] BucketLabels => view!.Buckets.Select(d => d.ToString("d MMM", L.Culture)).ToArray();

    private string Percent(double part, double whole) => whole == 0 ? "0%" : (part / whole * 100).ToString("0", L.Culture) + "%";
    private string Duration(int seconds) => $"{seconds / 60}{L["m"]} {seconds % 60}{L["s"]}";

    private static string RangeName(string r) => r switch { "7d" => "Last 7 days", "30d" => "Last 30 days", _ => "Last 90 days" };
    private static string PreviousName(string r) => r switch { "7d" => "previous 7 days", "30d" => "previous 30 days", _ => "previous 90 days" };
}
