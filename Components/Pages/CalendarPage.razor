@page "/calendar"
@using raxui_dashboard.Services
@inject DashboardData Data

<PageTitle>@L["Calendar"] · RaxUI Admin</PageTitle>

<header class="dash-page-header">
    <div>
        <h1>@L["Calendar"]</h1>
        <p>@L["Meetings, reviews and launches for the team."]</p>
    </div>
    <div class="dash-legend" aria-hidden="true">
        @foreach (var kind in Kinds)
        {
            <span><span class="dash-dot" data-kind="@kind"></span>@L[Title(kind)]</span>
        }
    </div>
</header>

<section class="dash-grid">
    <Card Class="dash-span-7 dash-calendar-card">
        <CardContent>
            <Calendar @bind-Value="day" @bind-Month="month" Today="Today" Culture="L.Culture" Class="dash-calendar">
                <DayContent Context="date">
                    @{ var kinds = events.Where(e => e.Date == date).Select(e => e.Kind).Distinct().Take(3).ToArray(); }
                    @if (kinds.Length > 0)
                    {
                        <span class="dash-day-dots">
                            @foreach (var kind in kinds) { <span class="dash-dot" data-kind="@kind"></span> }
                        </span>
                    }
                </DayContent>
            </Calendar>
        </CardContent>
    </Card>

    <Card Class="dash-span-5">
        <CardHeader>
            <CardTitle><h2>@(day?.ToString(L.Arabic ? "dddd، d MMMM" : "dddd, d MMMM", L.Culture))</h2></CardTitle>
            <CardDescription>@DayEvents.Length @L[DayEvents.Length == 1 ? "event" : "events"]</CardDescription>
        </CardHeader>
        <CardContent>
            @if (DayEvents.Length == 0)
            {
                <p class="dash-empty">@L["Nothing scheduled. Enjoy the quiet day."]</p>
            }
            else
            {
                <Timeline TimePosition="side" DoneLabel="@L["completed"]" CurrentLabel="@L["in progress"]" UpcomingLabel="@L["upcoming"]">
                    @foreach (var (e, i) in DayEvents.Select((e, i) => (e, i)))
                    {
                        <TimelineItem Index="i" Title="@L[e.Title]" Status="@StatusOf(e)" Tone="@ToneOf(e.Kind)"
                                      Time="@Time(e)" Description="@($"{L[Title(e.Kind)]} · {(e.End - e.Start).TotalMinutes:0} {L["min"]}")" />
                    }
                </Timeline>
            }
        </CardContent>
    </Card>

    <Card Class="dash-span-12">
        <CardHeader>
            <CardTitle><h2>@L["Upcoming"]</h2></CardTitle>
            <CardDescription>@L["The next events on the team calendar."]</CardDescription>
        </CardHeader>
        <CardContent>
            <div class="dash-upcoming">
                @foreach (var e in events.Where(e => e.Date > Today).OrderBy(e => e.Date).ThenBy(e => e.Start).Take(6))
                {
                    <button type="button" class="dash-upcoming-item" @onclick="() => { day = e.Date; month = new DateOnly(e.Date.Year, e.Date.Month, 1); }">
                        <span class="dash-upcoming-date">
                            <strong>@e.Date.Day</strong>
                            <small>@e.Date.ToString("MMM", L.Culture)</small>
                        </span>
                        <span class="dash-brand">
                            <strong>@L[e.Title]</strong>
                            <small><span class="dash-dot" data-kind="@e.Kind"></span> @L[Title(e.Kind)] · @Time(e)</small>
                        </span>
                    </button>
                }
            </div>
        </CardContent>
    </Card>
</section>

@code {
    [CascadingParameter] public Ui L { get; set; } = new(false);

    private static readonly DateOnly Today = new(2026, 11, 5);
    private static readonly TimeOnly Now = new(14, 20); // fixed "now" so the mock day always shows done, current and upcoming events
    private static readonly string[] Kinds = ["meeting", "review", "call", "event", "launch"];

    private IReadOnlyList<CalendarEvent> events = [];
    private DateOnly? day = Today;
    private DateOnly month = new(2026, 11, 1);

    protected override void OnInitialized() => events = Data.GetEvents();

    private CalendarEvent[] DayEvents => events.Where(e => e.Date == day).OrderBy(e => e.Start).ToArray();

    private string Time(CalendarEvent e) => e.Start == TimeOnly.MinValue ? L["All day"] : e.Start.ToString("HH:mm", L.Culture);

    private static string Title(string kind) => char.ToUpperInvariant(kind[0]) + kind[1..];

    private static string StatusOf(CalendarEvent e) =>
        e.Date < Today || e.Date == Today && e.End <= Now ? "done"
        : e.Date == Today && e.Start <= Now ? "current" : "upcoming";

    private static string ToneOf(string kind) => kind switch
    {
        "meeting" => "primary", "review" => "info", "call" => "success", "event" => "warning", _ => "danger",
    };
}
