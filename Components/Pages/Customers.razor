@page "/customers"
@using System.ComponentModel.DataAnnotations
@using raxui_dashboard.Services
@inject DashboardData Data

<PageTitle>@L["Customers"] · RaxUI Admin</PageTitle>

<header class="dash-page-header">
    <div>
        <h1>@L["Customers"]</h1>
        <p>@L["Search, filter and manage everyone who bought from your store."]</p>
    </div>
    <Button Size="sm" OnClick="OpenAdd">
        <Lucide Path="@Lucide.UserPlus" /> @L["Add customer"]
    </Button>
</header>

<Dialog @bind-Open="adding" Title="@L[editingId is null ? "Add customer" : "Edit customer"]" CloseLabel="@L["Close"]"
        Description="@L[editingId is null ? "They will get an email invite to your store." : "Update the customer's details."]">
    <ChildContent>
        <EditForm id="add-customer" Context="form" Model="draft" OnValidSubmit="SaveCustomer" class="dash-dialog-form">
            <DataAnnotationsValidator />
            <Field Id="customer-name" For="@(() => draft.Name)" Required="true">
                <FieldLabel>@L["Full name"]</FieldLabel>
                <Input @bind-Value="draft.Name" autocomplete="off" />
                <FieldError />
            </Field>
            <Field Id="customer-email" For="@(() => draft.Email)" Required="true">
                <FieldLabel>@L["Email"]</FieldLabel>
                <Input Type="email" @bind-Value="draft.Email" autocomplete="off" dir="ltr" />
                <FieldError />
            </Field>
            <div class="dash-dialog-row">
                <Field Id="customer-country" For="@(() => draft.Country)">
                    <FieldLabel>@L["Country"]</FieldLabel>
                    <Select TValue="string" @bind-Value="draft.Country">
                        @foreach (var c in DashboardData.Countries) { <option value="@c">@L[c]</option> }
                    </Select>
                </Field>
                <Field Id="customer-plan" For="@(() => draft.Plan)">
                    <FieldLabel>@L["Plan"]</FieldLabel>
                    <Select TValue="string" @bind-Value="draft.Plan">
                        @foreach (var p in PlanNames) { <option value="@p">@L[p]</option> }
                    </Select>
                </Field>
            </div>
            @if (editingId is null)
            {
                <Field Id="customer-trial" Orientation="inline">
                    <Switch @bind-Value="draft.Trial" />
                    <FieldLabel>@L["Start with a 14-day trial"]</FieldLabel>
                </Field>
            }
            else
            {
                <Field Id="customer-status" For="@(() => draft.Status)">
                    <FieldLabel>@L["Status"]</FieldLabel>
                    <Select TValue="string" @bind-Value="draft.Status">
                        @foreach (var s in StatusNames) { <option value="@s">@L[s]</option> }
                    </Select>
                </Field>
            }
        </EditForm>
    </ChildContent>
    <Footer>
        <Button Variant="outline" OnClick="() => adding = false">@L["Cancel"]</Button>
        <SubmitButton form="add-customer" Loading="saving" LoadingText="@L[editingId is null ? "Adding…" : "Saving…"]">
            @L[editingId is null ? "Add customer" : "Save changes"]
        </SubmitButton>
    </Footer>
</Dialog>

<Sheet @bind-Open="viewing" Title="@(viewed?.Name ?? "")" Description="@viewed?.Email" CloseLabel="@L["Close"]">
    <ChildContent>
        @if (viewed is not null)
        {
            <div class="dash-sheet-hero">
                <Avatar Size="xl" Name="@viewed.Name" />
                <Badge Color="@StatusColor(viewed.Status)" Dot>@L[viewed.Status]</Badge>
            </div>
            <dl class="dash-details">
                <dt>@L["Plan"]</dt>
                <dd><Badge Variant="outline" Color="@PlanColor(viewed.Plan)">@L[viewed.Plan]</Badge></dd>
                <dt>@L["Country"]</dt>
                <dd>@L[viewed.Country]</dd>
                <dt>@L["Orders"]</dt>
                <dd>@viewed.Orders.ToString("N0", L.Culture)</dd>
                <dt>@L["Spent"]</dt>
                <dd><span dir="ltr">@L.Money(viewed.Spent, 2)</span></dd>
                <dt>@L["Avg. order value"]</dt>
                <dd><span dir="ltr">@L.Money(viewed.Orders == 0 ? 0 : viewed.Spent / viewed.Orders, 2)</span></dd>
                <dt>@L["Last order"]</dt>
                <dd>@(viewed.Orders == 0 ? L["No orders yet"] : viewed.LastOrder.ToString("d MMMM yyyy", L.Culture))</dd>
                <dt>ID</dt>
                <dd><span class="dash-mono" dir="ltr">@viewed.Id</span></dd>
            </dl>
        }
    </ChildContent>
    <Footer>
        <Button Variant="outline" Class="text-danger" OnClick="() => AskDelete([viewed!])"><Lucide Path="@Lucide.Trash" /> @L["Delete"]</Button>
        <Button OnClick="() => Edit(viewed!)"><Lucide Path="@Lucide.Pencil" /> @L["Edit"]</Button>
    </Footer>
</Sheet>

<ConfirmDialog @bind-Open="confirmingDelete" Tone="destructive" ConfirmText="@L["Delete"]" CancelText="@L["Cancel"]" OnConfirm="DeleteAsync"
               Title="@L[deleting.Count == 1 ? "Delete this customer?" : "Delete these customers?"]"
               Description="@(deleting.Count == 1
                   ? $"“{deleting[0].Name}” {L["will be removed with their history. This can't be undone."]}"
                   : string.Format(L["The {0} selected customers will be removed with their history. This can't be undone."], deleting.Count))" />

<section class="dash-stats" aria-label="@L["Summary"]">
    @foreach (var (label, value) in Stats)
    {
        <Card Class="dash-stat">
            <CardContent>
                <span class="dash-stat-label">@label</span>
                <span class="dash-stat-value" dir="ltr">@value</span>
            </CardContent>
        </Card>
    }
</section>

<Card>
    <CardContent>
        <DataTable @ref="table" TItem="Customer" Items="customers" Columns="Columns" GetRowId="c => c.Id"
                   Label="@L["Customers"]" Labels="Labels" Loading="customers.Count == 0"
                   InitialSorting="@([new DataTableTypes.Sort("last", true)])" InitialHiddenColumns="@(["id"])">
            <Toolbar>
                <Button Size="sm" Variant="secondary" OnClick="@(() => message = L["Export started"] + $" · {customers.Count} CSV")">
                    <Lucide Path="@Lucide.Download" /> @L["Export"]
                </Button>
            </Toolbar>
            <BulkActions Context="selected">
                <Button Size="sm" Variant="ghost" OnClick="() => ExportSelected(selected)">@L["Export"]</Button>
                <Button Size="sm" Variant="ghost" Class="text-danger" OnClick="() => AskDelete(selected)">@L["Delete"]</Button>
            </BulkActions>
        </DataTable>
        <output class="dash-status" role="status">@message</output>
    </CardContent>
</Card>

@code {
    [CascadingParameter] public Ui L { get; set; } = new(false);

    private DataTable<Customer>? table;
    private IReadOnlyList<Customer> customers = [];
    private string message = "";

    private static readonly string[] PlanNames = ["Free", "Pro", "Business", "Enterprise"];
    private bool adding, saving;
    private CustomerDraft draft = new(new(false));
    private int nextId = 2042;

    // Error texts come from the cascaded Ui so they follow the interface language.
    private sealed class CustomerDraft(Ui l) : IValidatableObject
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Country { get; set; } = "Iraq";
        public string Plan { get; set; } = "Pro";
        public string Status { get; set; } = "Active";
        public bool Trial { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext context)
        {
            if (string.IsNullOrWhiteSpace(Name)) yield return new(l["Enter the customer's name."], [nameof(Name)]);
            if (!new EmailAddressAttribute().IsValid(Email) || string.IsNullOrWhiteSpace(Email))
                yield return new(l["Enter a valid email address."], [nameof(Email)]);
        }
    }

    private static readonly string[] StatusNames = ["Active", "Trial", "Paused", "Churned"];
    private string? editingId;            // null while adding
    private bool viewing, confirmingDelete;
    private Customer? viewed;
    private IReadOnlyList<Customer> deleting = [];

    private void OpenAdd()
    {
        editingId = null;
        draft = new(L);
        adding = true;
    }

    private void View(Customer c)
    {
        viewed = c;
        viewing = true;
    }

    private void Edit(Customer c)
    {
        viewing = false;
        editingId = c.Id;
        draft = new(L) { Name = c.Name, Email = c.Email, Country = c.Country, Plan = c.Plan, Status = c.Status };
        adding = true;
    }

    private void AskDelete(IReadOnlyList<Customer> rows)
    {
        if (rows.Count == 0) return;
        viewing = false;
        deleting = rows.ToArray();
        confirmingDelete = true;
    }

    // ConfirmDialog shows its own spinner while this runs and closes when it finishes.
    private async Task DeleteAsync()
    {
        await Data.SaveAsync();
        var ids = deleting.Select(r => r.Id).ToHashSet();
        customers = customers.Where(c => !ids.Contains(c.Id)).ToArray();
        message = deleting.Count == 1 ? $"{L["Deleted"]}: {deleting[0].Name}" : $"{L["Deleted"]}: {ids.Count}";
        deleting = [];
        if (table is not null) await table.ClearSelection();
    }

    private async Task SaveCustomer()
    {
        if (saving) return;
        saving = true;
        try
        {
            await Data.SaveAsync();
            if (editingId is { } id)
            {
                customers = customers.Select(c => c.Id != id ? c : c with
                {
                    Name = draft.Name.Trim(), Email = draft.Email.Trim(), Country = draft.Country, Plan = draft.Plan, Status = draft.Status,
                }).ToArray();
                message = L["Customer updated"] + $": {draft.Name.Trim()}";
            }
            else
            {
                var customer = new Customer($"C-{nextId++}", draft.Name.Trim(), draft.Email.Trim(), draft.Country, draft.Plan,
                    draft.Trial ? "Trial" : "Active", 0, 0, new DateOnly(2026, 11, 5));
                customers = [customer, .. customers];
                message = L["Customer added"] + $": {customer.Name}";
            }
            adding = false;
        }
        finally { saving = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        customers = await Data.GetCustomersAsync();
        StateHasChanged();
    }

    private (string, string)[] Stats =>
    [
        (L["Customers"], customers.Count.ToString("N0", L.Culture)),
        (L["Active"], customers.Count(c => c.Status == "Active").ToString("N0", L.Culture)),
        (L["Lifetime value"], L.Money(customers.Sum(c => c.Spent))),
        (L["Avg. orders"], customers.Count == 0 ? "0" : customers.Average(c => c.Orders).ToString("0.0", L.Culture)),
    ];

    private async Task ExportSelected(IReadOnlyList<Customer> rows)
    {
        message = L["Export started"] + $" · {rows.Count} CSV";
        if (table is not null) await table.ClearSelection();
    }

    private static string StatusColor(string s) => s switch { "Active" => "success", "Trial" => "info", "Paused" => "warning", _ => "neutral" };
    private static string PlanColor(string p) => p switch { "Enterprise" => "primary", "Business" => "info", "Pro" => "success", _ => "neutral" };

    private RenderFragment<Customer> CustomerCell => c =>
        @<span class="dash-customer">
            <Avatar Size="sm" Name="@c.Name" />
            <span class="dash-brand"><strong>@c.Name</strong><small>@c.Email</small></span>
        </span>;
    private RenderFragment<Customer> PlanCell => c => @<Badge Variant="outline" Color="@PlanColor(c.Plan)">@L[c.Plan]</Badge>;
    private RenderFragment<Customer> StatusCell => c => @<Badge Color="@StatusColor(c.Status)" Dot>@L[c.Status]</Badge>;
    private RenderFragment<Customer> ActionsCell => c =>
        @<DropdownMenu TriggerVariant="ghost" TriggerClass="dash-row-menu" TriggerLabel="@($"{L["Customer actions"]}: {c.Name}")">
            <Trigger><Lucide Path="@Lucide.Dots" /></Trigger>
            <ChildContent>
                <DropdownMenuItem OnSelect="() => View(c)"><Lucide Path="@Lucide.Eye" /> @L["View"]</DropdownMenuItem>
                <DropdownMenuItem OnSelect="() => Edit(c)"><Lucide Path="@Lucide.Pencil" /> @L["Edit"]</DropdownMenuItem>
                <DropdownMenuSeparator />
                <DropdownMenuItem Class="text-danger" OnSelect="() => AskDelete([c])"><Lucide Path="@Lucide.Trash" /> @L["Delete"]</DropdownMenuItem>
            </ChildContent>
        </DropdownMenu>;

    private DataTableTypes.Option[] Options(params string[] values) => values.Select(v => new DataTableTypes.Option(v, L[v])).ToArray();

    private IReadOnlyList<DataTableTypes.Column<Customer>> Columns =>
    [
        new() { Id = "id", Title = "ID", Value = c => c.Id },
        new() { Id = "customer", Title = L["Customer"], Value = c => c.Name + " " + c.Email, Cell = CustomerCell, Hideable = false },
        new() { Id = "country", Title = L["Country"], Value = c => c.Country, Format = v => L[(string)v!],
                Options = Options(customers.Select(c => c.Country).Distinct().Order().ToArray()) },
        new() { Id = "plan", Title = L["Plan"], Value = c => c.Plan, Cell = PlanCell, Options = Options("Free", "Pro", "Business", "Enterprise") },
        new() { Id = "status", Title = L["Status"], Value = c => c.Status, Cell = StatusCell, Options = Options("Active", "Trial", "Paused", "Churned") },
        new() { Id = "orders", Title = L["Orders"], Value = c => c.Orders, Align = "end", Searchable = false },
        new() { Id = "spent", Title = L["Spent"], Value = c => c.Spent, Format = v => L.Money((decimal)v!, 2), Align = "end", Searchable = false },
        new() { Id = "last", Title = L["Last order"], Value = c => c.LastOrder, Format = v => ((DateOnly)v!).ToString("d MMM yyyy", L.Culture), Searchable = false },
        new() { Id = "actions", Title = L["Actions"], Value = c => c.Id, Cell = ActionsCell, Sortable = false, Searchable = false, Hideable = false, Align = "end" },
    ];

    private DataTableTypes.Labels Labels => !L.Arabic ? new() { Search = "Search customers…" } : new()
    {
        Search = "ابحث عن عميل…", View = "العرض", Columns = "الأعمدة", Compact = "مضغوط", Comfortable = "مريح",
        Reset = "مسح الفلاتر", Empty = "لا توجد نتائج.", SelectAll = "تحديد صفوف الصفحة", SelectRow = "تحديد العميل",
        ClearSelection = "إلغاء التحديد", RowsPerPage = "صفوف الصفحة", Previous = "السابق", Next = "التالي",
        Pagination = "الصفحات", MorePages = "صفحات أخرى", BulkActions = "إجراءات جماعية",
        Results = n => $"{n} نتيجة", Selected = n => $"{n} محدد", Page = n => $"صفحة {n}",
    };
}
