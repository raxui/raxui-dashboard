@* Page performance rows: path, views, average engagement time, bounce rate. *@
<Table Density="compact">
    <TableHeader>
        <TableRow>
            <TableHead>@L["Page"]</TableHead>
            <TableHead Class="dash-num">@L["Views"]</TableHead>
            <TableHead Class="dash-num">@L["Avg. time"]</TableHead>
            <TableHead Class="dash-num">@L["Bounce rate"]</TableHead>
        </TableRow>
    </TableHeader>
    <TableBody>
        @foreach (var p in Pages)
        {
            <TableRow @key="p.Path">
                <TableCell><span class="dash-mono" dir="ltr">@p.Path</span></TableCell>
                <TableCell Class="dash-num"><bdi>@p.Views.ToString("N0", L.Culture)</bdi></TableCell>
                <TableCell Class="dash-num"><bdi>@($"{p.AvgSeconds / 60}{L["m"]} {p.AvgSeconds % 60}{L["s"]}")</bdi></TableCell>
                <TableCell Class="dash-num"><bdi>@((p.Bounce * 100).ToString("0", L.Culture))%</bdi></TableCell>
            </TableRow>
        }
    </TableBody>
</Table>
@code {
    [CascadingParameter] public Ui L { get; set; } = new(false);
    [Parameter, EditorRequired] public IReadOnlyList<PageStat> Pages { get; set; } = [];
}
