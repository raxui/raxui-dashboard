@* RaxUI Switch. Source-owned: edit freely. The React switch's track and thumb (the thumb stretches while pressed
   and springs across, as in boot-ui) around a real checkbox, so it posts in static SSR and needs no JavaScript. *@
@using Microsoft.AspNetCore.Components.Forms

<label class="@($"rax-switch rax-switch-native {Class} {ExtraClass}".TrimEnd())" data-rax-appearance="@Appearance">
    <InputCheckbox @attributes="Attributes" role="switch" class="rax-switch-input"
                   Value="Value" ValueChanged="ValueChanged" ValueExpression="OwnValueExpression" />
    <span class="rax-switch-thumb" aria-hidden="true">@if (Icon is not null) { <span class="rax-switch-icon" data-when="@(CheckedIcon is null ? null : "unchecked")">@Icon</span> }@if (CheckedIcon is not null) { <span class="rax-switch-icon" data-when="checked">@CheckedIcon</span> }</span>
</label>
@code {

    /// <summary>Bound value, including EditContext validation and static SSR form mapping.</summary>
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<bool>>? ValueExpression { get; set; }
    // Unbound use (no @bind-Value): the inner input still needs an expression, so point it at this component's own value.
    private System.Linq.Expressions.Expression<Func<bool>>? _ownValueExpression;
    private System.Linq.Expressions.Expression<Func<bool>> OwnValueExpression => ValueExpression ?? (_ownValueExpression ??= () => Value);

    [CascadingParameter] private Field.FieldContext? FieldContext { get; set; }
    /// <summary>Icon in the thumb; it takes the "on" tint when checked.</summary>
    [Parameter] public RenderFragment? Icon { get; set; }
    /// <summary>Icon in the thumb when checked; Icon then shows only when unchecked.</summary>
    [Parameter] public RenderFragment? CheckedIcon { get; set; }
    /// <summary>default, flat, or glass; null inherits the surrounding theme.</summary>
    [Parameter] public string? Appearance { get; set; }
    /// <summary>Extra CSS classes appended to the control.</summary>
    [Parameter] public string? Class { get; set; }
    private string? ExtraClass => AdditionalAttributes is not null && AdditionalAttributes.TryGetValue("class", out var value) ? Convert.ToString(value) : null;
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    private readonly string _autoId = $"rax-control-{Guid.NewGuid():N}";
    private Dictionary<string, object> ControlAttributes
    {
        get
        {
            var attrs = FieldContext is null ? new Dictionary<string, object>() : new(FieldContext.ControlAttributes);
            if (AdditionalAttributes is not null)
                foreach (var pair in AdditionalAttributes) attrs[pair.Key] = pair.Value;
            if (!attrs.ContainsKey("id")) attrs["id"] = _autoId;
            return attrs;
        }
    }
    private string ControlId => Convert.ToString(ControlAttributes["id"])!;

    private Dictionary<string, object> Attributes
    {
        get
        {
            var attrs = ControlAttributes;
            attrs.TryAdd("aria-checked", Value ? "true" : "false");
            return attrs;
        }
    }
}
