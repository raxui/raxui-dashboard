@implements IDisposable
<div @attributes="AdditionalAttributes" class="rax-ai-response @(Markdown ? "rax-typeset" : null) @Class" data-streaming="@(Streaming ? "" : null)" data-markdown="@(Markdown ? "" : null)" dir="auto" aria-busy="@(Streaming ? "true" : null)">
@if (Markdown && Text is not null) { <AIMarkdown Text="@Text" Streaming="Streaming" CopyLabel="@CopyLabel" CopiedLabel="@CopiedLabel" /> }
else { @Text @ChildContent }
</div>
@code {
    /// <summary>Response text; with Markdown it renders the documented GFM subset. Raw HTML is never rendered.</summary>
    [Parameter] public string? Text { get; set; }
    [Parameter] public bool Markdown { get; set; }
    /// <summary>Shows a blinking caret while text is still arriving.</summary>
    [Parameter] public bool Streaming { get; set; }
    /// <summary>Minimum milliseconds between renders while streaming.</summary>
    [Parameter] public int RenderInterval { get; set; } = 50;
    [Parameter] public string CopyLabel { get; set; } = "Copy";
    [Parameter] public string CopiedLabel { get; set; } = "Copied";
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    private long last;
    private bool scheduled, flushing, disposed;
    // Under Interactive Server every render is a network diff; coalesce fast streaming updates.
    protected override bool ShouldRender()
    {
        var now = Environment.TickCount64;
        if (flushing || !Streaming || now - last >= RenderInterval) { flushing = false; last = now; return true; }
        if (!scheduled) { scheduled = true; _ = Flush(RenderInterval - (int)(now - last)); }
        return false;
    }
    private async Task Flush(int delay)
    {
        await Task.Delay(Math.Max(1, delay));
        scheduled = false; if (disposed) return;
        flushing = true; await InvokeAsync(StateHasChanged);
    }
    public void Dispose() => disposed = true;
}
