<div @attributes="AdditionalAttributes" class="rax-ai-message @Class" data-from="@From">
@if (From == "assistant") { <div class="rax-ai-avatar" aria-hidden="true">@if (Avatar is null) { <AIIcon Name="spark" /> } else { @Avatar }</div> }
<div class="rax-ai-message-body" dir="@(From == "user" ? "auto" : null)">@ChildContent</div>
</div>
@code {
    /// <summary>user or assistant.</summary>
    [Parameter, EditorRequired] public string From { get; set; } = "assistant";
    /// <summary>Assistant avatar; defaults to a spark mark.</summary>
    [Parameter] public RenderFragment? Avatar { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    protected override void OnParametersSet() { if (From is not ("user" or "assistant")) throw new ArgumentException("AIMessage From must be user or assistant."); }
}
