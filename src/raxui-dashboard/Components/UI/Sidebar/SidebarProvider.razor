@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
<CascadingValue Value="this"><div @ref="element" @attributes="AdditionalAttributes" class="rax-sidebar-wrapper @Class" data-blazor-shell data-state="@(Current ? "expanded" : "collapsed")" data-rax-appearance="@Appearance">@ChildContent</div></CascadingValue>
@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public bool DefaultOpen { get; set; } = true;
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string? StorageKey { get; set; }
    [Parameter] public string? Shortcut { get; set; } = "b";
    [Parameter] public string? Appearance { get; set; }
    internal bool Current => OpenChanged.HasDelegate ? Open : localOpen ?? (Open || DefaultOpen);
    internal bool Mobile { get; private set; }
    internal bool MobileOpen { get; private set; }
    /// <summary>Whether the sidebar is showing: expanded on desktop, or the Sheet open on phones. Use it to drive a custom trigger such as MenuToggle.</summary>
    public bool IsOpen => Mobile ? MobileOpen : Current;
    /// <summary>True once the browser module is ready; a custom trigger should stay disabled until then.</summary>
    public bool Ready { get; private set; }
    /// <summary>The panel id, for a custom trigger's aria-controls.</summary>
    public string PanelId { get; } = "rax-sidebar-" + Guid.NewGuid().ToString("N");
    private bool? localOpen;
    private bool disposed;
    private ElementReference element; private IJSObjectReference? module; private DotNetObjectReference<SidebarProvider>? self;
    protected override void OnInitialized() => Navigation.LocationChanged += LocationChanged;
    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args) => _ = InvokeAsync(async () => { await SetMobileOpen(false); StateHasChanged(); });
    // An empty Href is the app root, as in an anchor.
    internal bool IsCurrent(string? href, bool exact) { if (href is null) return false; var current = Navigation.ToAbsoluteUri(Navigation.Uri); var target = Navigation.ToAbsoluteUri(href); return current.GetLeftPart(UriPartial.Path).TrimEnd('/').Equals(target.GetLeftPart(UriPartial.Path).TrimEnd('/'), StringComparison.OrdinalIgnoreCase) && (string.IsNullOrEmpty(target.Fragment) || current.Fragment == target.Fragment) || !exact && current.GetLeftPart(UriPartial.Authority) == target.GetLeftPart(UriPartial.Authority) && current.AbsolutePath.StartsWith(target.AbsolutePath.TrimEnd('/') + "/", StringComparison.OrdinalIgnoreCase); }
    [JSInvokable] public Task Toggle() => Mobile ? SetMobileOpen(!MobileOpen) : SetOpen(!Current);
    internal async Task SetOpen(bool value) { localOpen = value; if (module is not null) await module.InvokeVoidAsync("remember", StorageKey, value); await OpenChanged.InvokeAsync(value); await InvokeAsync(StateHasChanged); }
    internal async Task SetMobileOpen(bool value) { MobileOpen = value; await InvokeAsync(StateHasChanged); }
    [JSInvokable] public async Task MediaChanged(bool value) { Mobile = value; MobileOpen = false; await InvokeAsync(StateHasChanged); }
    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (disposed) return;
        self ??= DotNetObjectReference.Create(this); module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/UI/Sidebar/SidebarProvider.razor.js");
        if (disposed) { await module.DisposeAsync(); return; }
        var environment = await module.InvokeAsync<System.Text.Json.JsonElement>("init", element, self, Shortcut, StorageKey);
        if (!Ready) { Ready = true; Mobile = environment.GetProperty("mobile").GetBoolean(); if (!OpenChanged.HasDelegate && environment.TryGetProperty("stored", out var stored) && stored.ValueKind is System.Text.Json.JsonValueKind.True or System.Text.Json.JsonValueKind.False) localOpen = stored.GetBoolean(); StateHasChanged(); }
    }
    public async ValueTask DisposeAsync() { disposed = true; Navigation.LocationChanged -= LocationChanged; if (module is not null) { try { await module.InvokeVoidAsync("dispose", element); await module.DisposeAsync(); } catch (JSDisconnectedException) { } } self?.Dispose(); }
}
