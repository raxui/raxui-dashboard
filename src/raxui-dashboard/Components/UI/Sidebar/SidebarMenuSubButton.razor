@if (Href is not null) { <a data-enhance-nav="@(PreventDefault ? "false" : null)" @onclick:preventDefault="@PreventDefault" @attributes="AdditionalAttributes" class="rax-sidebar-menu-sub-button @Class" data-sidebar="menu-sub-button" data-size="@Size" data-variant="@Variant" data-active="@(Current ? "" : null)" aria-current="@(Current ? "page" : null)" title="@Tooltip" @onclick="Click" href="@(Disabled ? null : Href)" aria-disabled="@(Disabled ? "true" : null)" tabindex="@(Disabled ? "-1" : null)">@Icon<span>@ChildContent</span></a> } else { <button @attributes="AdditionalAttributes" class="rax-sidebar-menu-sub-button @Class" data-sidebar="menu-sub-button" data-size="@Size" data-variant="@Variant" data-active="@(Current ? "" : null)" aria-current="@(Current ? "page" : null)" title="@Tooltip" @onclick="Click" type="button" disabled="@Disabled">@Icon<span>@ChildContent</span></button> }
@code {
    [Parameter] public bool PreventDefault { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [CascadingParameter] public SidebarProvider? Parent { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool? IsActive { get; set; }
    [Parameter] public bool Exact { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Size { get; set; } = "default";
    [Parameter] public string Variant { get; set; } = "default";
    [Parameter] public string? Tooltip { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    private bool Current => IsActive ?? Parent?.IsCurrent(Href, Exact) ?? false;
    private async Task Click(MouseEventArgs args) { if (Disabled) return; await OnClick.InvokeAsync(args); if (Href is not null && Parent?.Mobile == true) await Parent.SetMobileOpen(false); }
}
