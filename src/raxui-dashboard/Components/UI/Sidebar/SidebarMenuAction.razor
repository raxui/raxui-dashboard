<button @attributes="AdditionalAttributes" type="button" class="rax-sidebar-menu-action @Class" aria-label="@Label" data-show-on-hover="@(ShowOnHover ? "" : null)" @onclick="OnClick">@ChildContent</button>
@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public bool ShowOnHover { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
}
