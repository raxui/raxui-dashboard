@* RaxUI Popover. Source-owned: edit freely. Native popover top layer with anchored positioning (ADR 013). Enhancements require interactivity. *@
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@if (Trigger is not null)
{
    <button @attributes="TriggerAttributes" @ref="_trigger" type="button" class="@($"rax-popover-trigger {TriggerClass}")"
            popovertarget="@Id" aria-haspopup="@PopupRole" aria-controls="@TriggerControls" aria-expanded="@(Open ? "true" : "false")">@Trigger</button>
}
<div @ref="_content" @attributes="AdditionalAttributes" id="@Id" popover="auto" role="@Role" aria-label="@Label"
     class="@($"rax-popover {Class}")" data-rax-appearance="@Appearance">@ChildContent</div>
@code {
    [Parameter] public string Id { get; set; } = $"rax-popover-{Guid.NewGuid():N}";
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public RenderFragment? Trigger { get; set; }
    [Parameter] public string? TriggerClass { get; set; }
    [Parameter] public IDictionary<string, object>? TriggerAttributes { get; set; }
    /// <summary>External anchor for input-triggered suggestions; omit Trigger when using it.</summary>
    [Parameter] public ElementReference Anchor { get; set; }
    [Parameter] public string PopupRole { get; set; } = "dialog";
    [Parameter] public string? Role { get; set; } = "dialog";
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Appearance { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    private string TriggerControls => TriggerAttributes is not null && TriggerAttributes.TryGetValue("aria-controls", out var id) ? Convert.ToString(id) ?? Id : Id;
    private ElementReference _trigger, _content;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Popover>? _self;
    private bool? _lastOpen;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_module is null)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/UI/Popover/Popover.razor.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("init", Trigger is null ? Anchor : _trigger, _content, _self, string.IsNullOrEmpty(Anchor.Id) ? null : Anchor);
        }
        if (_lastOpen != Open) { _lastOpen = Open; await _module.InvokeVoidAsync("setOpen", _content, Open); }
    }
    [JSInvokable] public async Task Toggled(bool open)
    {
        if (Open == open) return;
        Open = open; _lastOpen = open;
        await OpenChanged.InvokeAsync(open); StateHasChanged();
    }
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _content); await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
