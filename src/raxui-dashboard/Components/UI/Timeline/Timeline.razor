@* RaxUI Timeline. Source-owned: edit freely. Styled by the timeline component CSS. *@
<CascadingValue Value="this">
    <div tabindex="@(Layout=="horizontal"?0:null)" class="rax-timeline-wrap" data-layout="@Layout">
        <ol @attributes="AdditionalAttributes" class="@($"rax-timeline {Class}")" data-layout="@Layout" data-time="@EffectiveTimePosition" data-size="@Size" data-animated="@(Animated ? "true" : null)" data-rax-appearance="@Appearance">@ChildContent</ol>
    </div>
</CascadingValue>
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>default, flat, or glass; null inherits the surrounding theme.</summary>
    [Parameter] public string? Appearance { get; set; }
    /// <summary>Extra CSS classes.</summary>
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [Parameter] public string Layout { get; set; } = "start";
    public string EffectiveTimePosition=>Layout=="alternate"?"side":Layout=="horizontal"?"inline":TimePosition;
    protected override void OnParametersSet(){if(Layout is not ("start" or "alternate" or "horizontal") || TimePosition is not ("inline" or "side"))throw new ArgumentException("Invalid timeline layout or time position.");}
    [Parameter] public string TimePosition { get; set; } = "inline";
    [Parameter] public string Size { get; set; } = "default";
    [Parameter] public bool Animated { get; set; } = true;
    [Parameter] public string DoneLabel { get; set; } = "completed";
    [Parameter] public string CurrentLabel { get; set; } = "in progress";
    [Parameter] public string UpcomingLabel { get; set; } = "upcoming";
    [Parameter] public string ErrorLabel { get; set; } = "failed";
    public string StatusLabel(string status) => status switch { "current" => CurrentLabel, "upcoming" => UpcomingLabel, "error" => ErrorLabel, _ => DoneLabel };
}
