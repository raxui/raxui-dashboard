@* RaxUI TableHead. Source-owned: edit freely. Styled by the table component CSS. *@
<th @attributes="AdditionalAttributes" class="@Class" data-rax-appearance="@Appearance" scope="@Scope">@ChildContent</th>
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>default, flat, or glass; null inherits the surrounding theme.</summary>
    [Parameter] public string? Appearance { get; set; }
    /// <summary>Extra CSS classes.</summary>
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [Parameter] public string Scope { get; set; } = "col";
}
