<li><a data-enhance-nav="@(PreventDefault ? "false" : null)" @onclick:preventDefault="@PreventDefault" @attributes="AdditionalAttributes" href="@Href" class="rax-navbar-link @Class" aria-current="@((Active ?? Parent?.IsCurrent(Href, Exact) ?? false) ? "page" : null)" @onclick="Click">@ChildContent</a></li>
@code {
    [Parameter] public bool PreventDefault { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    [CascadingParameter] public Navbar? Parent { get; set; }
    [Parameter] public string Href { get; set; } = "/";
    [Parameter] public bool? Active { get; set; }
    [Parameter] public bool Exact { get; set; } = true;
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    private async Task Click(MouseEventArgs args) { await OnClick.InvokeAsync(args); }
}
