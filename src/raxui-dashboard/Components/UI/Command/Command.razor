@implements IAsyncDisposable
@inject IJSRuntime JS
@if (Inline)
{
    @Surface
}
else
{
    <dialog @ref="_dialog" @attributes="AdditionalAttributes" class="rax-command-dialog @Class" aria-labelledby="@(_id + "-title")" data-rax-appearance="@Appearance" @onclose="Closed">
        <h2 id="@(_id + "-title")" class="visually-hidden">@Title</h2>
        @Surface
    </dialog>
}
@code {
    public record Item(string Value, string Label, string Group = "", bool Disabled = false, string Keywords = "", RenderFragment? Icon = null, string? Shortcut = null, string? Description = null, bool ForceMount = false);
    [Parameter] public bool Inline { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public List<Item> Items { get; set; } = new();
    [Parameter] public EventCallback<string> OnSelect { get; set; }
    [Parameter] public string Search { get; set; } = "";
    [Parameter] public EventCallback<string> SearchChanged { get; set; }
    [Parameter] public bool ShouldFilter { get; set; } = true;
    [Parameter] public Func<Item, string, bool>? Filter { get; set; }
    [Parameter] public bool Loop { get; set; } = true;
    [Parameter] public bool CloseOnSelect { get; set; } = true;
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string LoadingMessage { get; set; } = "Loading…";
    [Parameter] public string? Shortcut { get; set; }
    [Parameter] public RenderFragment? Leading { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public RenderFragment<Item>? ItemTemplate { get; set; }
    [Parameter] public string Title { get; set; } = "Command palette";
    [Parameter] public string SearchPlaceholder { get; set; } = "Search commands…";
    [Parameter] public string EmptyMessage { get; set; } = "No results found.";
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Appearance { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    private readonly string _id = "rax-command-" + Guid.NewGuid().ToString("N");
    private ElementReference _dialog, _input, _list;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Command>? _reference;
    private bool? _lastOpen;
    private IEnumerable<Item> Filtered => Items.Where(item => item.ForceMount || !ShouldFilter || (Filter?.Invoke(item, Search) ?? ChoiceSearch.Matches(item.Label + " " + item.Keywords, Search)));
    private RenderFragment Surface => @<div @attributes="@(Inline ? AdditionalAttributes : null)" class="rax-command @(Inline ? Class : null)" data-rax-appearance="@Appearance" data-searching="@(Search.Length > 0 ? "" : null)">
        <div class="rax-command-input-wrap">
            @Leading
            <span class="rax-command-input-icon" aria-hidden="true">
                @if (Loading) { <span class="spinner-border spinner-border-sm"></span> }
                else { <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m16 16 4 4"/></svg> }
            </span>
            <input @ref="_input" class="rax-command-input" role="combobox" aria-expanded="true" aria-controls="@(_id + "-list")" aria-autocomplete="list" aria-label="@SearchPlaceholder" placeholder="@SearchPlaceholder" value="@Search" @oninput="SearchInput" />
        </div>
        <div @ref="_list" id="@(_id + "-list")" role="listbox" data-command-list data-loop="@(Loop ? "true" : "false")" data-close-on-select="@(CloseOnSelect ? "true" : "false")" aria-label="@Title" aria-busy="@(Loading ? "true" : "false")" class="rax-command-list">
            <div class="rax-command-list-inner">
                <span class="rax-command-highlight" data-choice-highlight hidden aria-hidden="true"></span>
                @{ var groups = Filtered.GroupBy(item => item.Group).ToList(); }
                @for (var g = 0; g < groups.Count; g++)
                {
                    var group = groups[g];
                    @if (g > 0) { <div role="separator" class="rax-command-separator"></div> }
                    <div role="group" aria-label="@group.Key" class="rax-command-group">
                        @if (!string.IsNullOrEmpty(group.Key)) { <div class="rax-command-group-heading">@group.Key</div> }
                        @foreach (var item in group)
                        {
                            <div @key="item.Value" id="@(_id + "-" + Items.IndexOf(item))" role="option" aria-selected="false" aria-disabled="@(item.Disabled ? "true" : "false")" data-value="@item.Value" class="rax-command-item" @onclick="@(() => Select(item.Value))">
                                @if (ItemTemplate is not null) { @ItemTemplate(item) }
                                else
                                {
                                    @if (item.Icon is not null) { <span class="rax-command-item-icon">@item.Icon</span> }
                                    <span>@item.Label @if (item.Description is not null) { <span class="rax-command-item-hint">@item.Description</span> }</span>
                                    @if (item.Shortcut is not null) { <span class="rax-command-shortcut">@item.Shortcut</span> }
                                }
                            </div>
                        }
                    </div>
                }
                @if (Loading) { <div class="rax-command-loading" role="status">@LoadingMessage</div> }
                else { <div class="rax-command-empty" role="status">@EmptyMessage</div> }
            </div>
        </div>
        @if (Footer is not null) { <div class="rax-command-footer">@Footer</div> }
    </div>;
    private async Task SearchInput(ChangeEventArgs args) { Search = Convert.ToString(args.Value) ?? ""; await SearchChanged.InvokeAsync(Search); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _reference ??= DotNetObjectReference.Create(this);
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/UI/Command/Command.razor.js");
        await _module.InvokeVoidAsync("init", Inline ? null : _dialog, _input, _list, _reference, Shortcut);
        if (!Inline && _lastOpen != Open) { _lastOpen = Open; await _module.InvokeVoidAsync("setOpen", _dialog, Open); }
    }
    [JSInvokable] public async Task Select(string value)
    {
        if (Loading || !Filtered.Any(item => item.Value == value && !item.Disabled)) return;
        await OnSelect.InvokeAsync(value);
        if (CloseOnSelect) await Close();
    }
    [JSInvokable] public async Task Close() { if (!Inline && _module is not null) await _module.InvokeVoidAsync("setOpen", _dialog, false); }
    private Task Closed() { Open = false; _lastOpen = false; return OpenChanged.InvokeAsync(false); }
    public async Task ShowAsync() { if (!Inline && _module is not null) await _module.InvokeVoidAsync("setOpen", _dialog, true); Open = true; _lastOpen = true; await OpenChanged.InvokeAsync(true); }
    [JSInvokable] public async Task Toggle() { if (Open) await Close(); else await ShowAsync(); }
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", Inline ? null : _dialog, _input); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _reference?.Dispose();
    }
}
