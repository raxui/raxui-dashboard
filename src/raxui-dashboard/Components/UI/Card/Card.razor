@* RaxUI Card. Source-owned: edit freely. Styled by the card component CSS. *@
<div @attributes="AdditionalAttributes" class="@($"card rax-card card-glass {(Variant == "default" ? "" : $"card-glass-{Variant}")} {Class}")" data-rax-appearance="@Appearance">@ChildContent</div>
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>default, flat, or glass; null inherits the surrounding theme.</summary>
    [Parameter] public string? Appearance { get; set; }
    /// <summary>Extra CSS classes.</summary>
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    /// <summary>default, tinted, or outline.</summary>
    [Parameter] public string Variant { get; set; } = "default";
}
