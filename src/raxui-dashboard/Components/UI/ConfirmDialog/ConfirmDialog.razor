@* RaxUI ConfirmDialog. Source-owned: edit freely. A centred confirmation on the native <dialog> (ADR 013),
   from boot-ui's AlertDialog, with the same classes and behavior as the React ConfirmDialog. A click outside
   nudges the panel instead of closing it; Esc or Cancel close it. Needs an interactive render mode. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog @ref="_element"
        @attributes="AdditionalAttributes"
        role="alertdialog"
        class="@CssClass"
        data-tone="@Tone"
        aria-labelledby="@TitleId"
        aria-describedby="@(Description is null ? null : DescriptionId)"
        aria-busy="@(_pending ? "true" : null)"
        data-rax-appearance="@Appearance"
        @onclose="HandleCloseAsync">
    @if (ShowIcon)
    {
        <div class="rax-confirm-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="@IconPath" />
            </svg>
        </div>
    }
    <div class="rax-confirm-header">
        <h2 id="@TitleId" class="rax-confirm-title">@Title</h2>
        @if (Description is not null)
        {
            <p id="@DescriptionId" class="rax-confirm-description">@Description</p>
        }
    </div>
    @if (ConfirmationText is not null)
    {
        <form class="rax-confirm-field" @onsubmit="ConfirmAsync" @onsubmit:preventDefault>
            <label for="@FieldId" class="form-label small">@(ConfirmationLabel ?? $"Type {ConfirmationText} to confirm")</label>
            <input id="@FieldId" class="form-control form-control-sm" @bind="_typed" @bind:event="oninput"
                   autocomplete="off" autocapitalize="off" spellcheck="false" disabled="@_pending" placeholder="@ConfirmationText" />
        </form>
    }
    @if (_error is not null)
    {
        <div class="rax-confirm-error" role="alert">@_error</div>
    }
    <div class="rax-confirm-footer" data-layout="@Layout">
        @* Focus starts on Cancel, the safe choice, unless there is a field to type into. *@
        <button type="button" class="btn rax-button btn-glass btn-glass-secondary rax-confirm-cancel"
                autofocus="@(ConfirmationText is null)" disabled="@_pending" @onclick="CancelAsync">@CancelText</button>
        <button type="button" class="btn rax-button btn-glass @ActionClass rax-confirm-action"
                disabled="@(!CanConfirm)" data-pending="@(_pending ? "" : null)" @onclick="ConfirmAsync">
            @if (_pending)
            {
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            }
            <span>@ConfirmText</span>
        </button>
    </div>
</dialog>

@code {
    private static readonly Dictionary<string, string> IconPaths = new()
    {
        ["default"] = "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM12 11v5M12 8h.01",
        ["destructive"] = "M4 7h16M10 11v6M14 11v6M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2l1-12M9 7V4h6v3",
        ["warning"] = "M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z",
        ["success"] = "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM8 12.5l2.5 2.5L16 9.5",
    };

    private readonly string _id = $"rax-confirm-{Guid.NewGuid():N}";
    private ElementReference _element;
    private IJSObjectReference? _module;
    private bool _shown;
    private bool _pending;
    private bool _confirmed;
    private string _typed = "";
    private string? _error;

    /// <summary>Whether the dialog is open. Use with @bind-Open.</summary>
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>The question, for example "Delete this project?". Names the dialog for screen readers.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string? Description { get; set; }

    /// <summary>default, destructive, warning, or success. Sets the icon, its tint, and a red action for destructive.</summary>
    [Parameter] public string Tone { get; set; } = "default";

    [Parameter] public bool ShowIcon { get; set; } = true;

    [Parameter] public string ConfirmText { get; set; } = "Confirm";

    [Parameter] public string CancelText { get; set; } = "Cancel";

    /// <summary>Requires typing this exact text (for example a project name) before confirming.</summary>
    [Parameter] public string? ConfirmationText { get; set; }

    /// <summary>The type-to-confirm field's label. Defaults to "Type {ConfirmationText} to confirm".</summary>
    [Parameter] public string? ConfirmationLabel { get; set; }

    /// <summary>inline (two buttons side by side) or stacked (full-width rows, for long labels).</summary>
    [Parameter] public string Layout { get; set; } = "inline";

    /// <summary>
    /// Runs on confirm. The dialog shows a spinner and stays open until it finishes, then closes.
    /// If it throws, the message is shown and the user can try again.
    /// </summary>
    [Parameter] public EventCallback OnConfirm { get; set; }

    /// <summary>Runs when the dialog closes without confirming: Cancel or Esc.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>default, flat, or glass. When null, the dialog inherits it from the nearest ancestor with data-rax-appearance.</summary>
    [Parameter] public string? Appearance { get; set; }

    /// <summary>Extra CSS classes appended after the component's own classes.</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private string TitleId => $"{_id}-title";
    private string DescriptionId => $"{_id}-description";
    private string FieldId => $"{_id}-field";
    private string CssClass => string.IsNullOrEmpty(Class) ? "rax-confirm" : $"rax-confirm {Class}";
    private string IconPath => IconPaths.GetValueOrDefault(Tone, IconPaths["default"]);
    private string ActionClass => Tone == "destructive" ? "btn-glass-destructive" : "btn-glass-primary";
    private bool CanConfirm => !_pending && (ConfirmationText is null || _typed.Trim() == ConfirmationText);

    private async Task ConfirmAsync()
    {
        if (!CanConfirm) return;
        _error = null;
        _pending = true;
        try
        {
            await OnConfirm.InvokeAsync();
            _confirmed = true;
            await SetOpenAsync(false);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _pending = false;
        }
    }

    private Task CancelAsync() => SetOpenAsync(false);

    private async Task SetOpenAsync(bool open)
    {
        if (Open == open) return;
        Open = open;
        await OpenChanged.InvokeAsync(open);
    }

    // Each opening starts clean: no typed text, no error from last time.
    protected override void OnParametersSet()
    {
        if (!Open || _shown) return;
        _typed = "";
        _error = null;
        _confirmed = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/UI/ConfirmDialog/ConfirmDialog.razor.js");
            await _module.InvokeVoidAsync("init", _element);
        }
        if (_module is not null && Open != _shown)
        {
            _shown = Open;
            await _module.InvokeVoidAsync("setOpen", _element, Open);
        }
    }

    // The native close event: Esc, Cancel, a successful confirm, or Open set to false.
    private async Task HandleCloseAsync()
    {
        _shown = false;
        var cancelled = !_confirmed;
        _confirmed = false;
        await SetOpenAsync(false);
        if (cancelled) await OnCancel.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; the browser already dropped the module.
        }
    }
}
