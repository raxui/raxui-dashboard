@* Source-owned native modal panel. Shared gestures live in Sheet.razor.js. *@
@implements IAsyncDisposable
@inject IJSRuntime JS
<dialog @ref="_element" @attributes="AdditionalAttributes" id="@DialogId" class="rax-sheet-content @Class" data-rax-appearance="@Appearance"
        data-side="@Side" aria-labelledby="@(_id + "-title")" aria-describedby="@(Description is null ? null : _id + "-description")" @onclose="Closed">
    @if (EffectiveHandle)
    {
        <button type="button" class="rax-sheet-handle" data-panel-handle aria-label="@HandleLabel" aria-controls="@DialogId"></button>
    }
    <div class="rax-sheet-header @HeaderClass">
        <h2 id="@(_id + "-title")" class="rax-sheet-title">@Title</h2>
        @if (Description is not null) { <p id="@(_id + "-description")" class="rax-sheet-description">@Description</p> }
    </div>
    <div class="rax-sheet-body @BodyClass">@ChildContent</div>
    @if (Footer is not null) { <div class="rax-sheet-footer @FooterClass">@Footer</div> }
    @if (ShowCloseButton)
    {
        <button type="button" class="rax-sheet-close" aria-label="@CloseLabel" @onclick="CloseAsync">
            @* Lucide X, ISC license. *@
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
        </button>
    }
</dialog>
@code {
    private readonly string _id = "rax-sheet-" + Guid.NewGuid().ToString("N");
    private string DialogId => AdditionalAttributes is not null && AdditionalAttributes.TryGetValue("id", out var id) ? Convert.ToString(id) ?? _id : _id;
    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Sheet>? _self;
    private bool? _parameterOpen, _lastOpen;
    private bool _requestedOpen, _initialized;
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public string CloseLabel { get; set; } = "Close";
    [Parameter] public string HandleLabel { get; set; } = "Drag sheet";
    [Parameter] public string Side { get; set; } = "end";
    [Parameter] public bool Draggable { get; set; } = true;
    [Parameter] public bool? ShowHandle { get; set; }
    [Parameter] public bool ShowCloseButton { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? HeaderClass { get; set; }
    [Parameter] public string? BodyClass { get; set; }
    [Parameter] public string? FooterClass { get; set; }
    [Parameter] public string? Appearance { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    private bool EffectiveHandle => ShowHandle ?? (Side == "bottom");
    [JSInvokable] public Task Snapped(string point) => Task.CompletedTask;
    protected override void OnParametersSet()
    {
        if (Side is not ("start" or "end" or "left" or "right" or "top" or "bottom")) throw new ArgumentException("Side must be start, end, left, right, top or bottom.", nameof(Side));
        // A binding render can deliver the previous value before the native close callback is applied.
        if (_parameterOpen != Open) { _parameterOpen = Open; _requestedOpen = Open; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _self ??= DotNetObjectReference.Create(this);
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/UI/Sheet/Sheet.razor.js");
        await _module.InvokeVoidAsync("configure", _element, _self, new { kind = "sheet", side = Side, draggable = Draggable, snapPoints = Array.Empty<string>(), activeSnapPoint = (string?)null, fadeFromIndex = 1 });
        _initialized = true;
        if (_lastOpen != _requestedOpen) { _lastOpen = _requestedOpen; await _module.InvokeVoidAsync("setOpen", _element, _requestedOpen); }
    }
    public async Task ShowAsync() { Open = true; _requestedOpen = true; if (_initialized && _module is not null) { _lastOpen = true; await _module.InvokeVoidAsync("setOpen", _element, true); } await OpenChanged.InvokeAsync(true); }
    public async Task CloseAsync() { if (_initialized && _module is not null) await _module.InvokeVoidAsync("setOpen", _element, false); else { Open = false; _requestedOpen = false; await OpenChanged.InvokeAsync(false); } }
    private async Task Closed() { Open = false; _requestedOpen = false; _lastOpen = false; await OpenChanged.InvokeAsync(false); }
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _element); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
