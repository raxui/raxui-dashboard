@* RaxUI Input. Source-owned: edit freely. Native form behavior also works in static SSR. *@
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_element" class="rax-input-group" data-size="@Size" data-start="@(StartIcon is not null ? "" : null)"
     data-end="@(EndIcon is not null || Clearable || Type == "password" ? "" : null)" data-rax-appearance="@Appearance">
    @if (StartIcon is not null)
    {
        <label for="@ControlId" class="rax-input-slot" data-side="start" aria-hidden="true">@StartIcon</label>
    }
    <InputText @attributes="ControlAttributes" type="@Type" class="@($"form-control rax-input {SizeClass} {Class} {ExtraClass}".TrimEnd())"
               data-variant="@Variant" Value="@Value" ValueChanged="ValueChanged" ValueExpression="OwnValueExpression" />
    @if (EndIcon is not null || Clearable || Type == "password")
    {
        <span class="rax-input-slot" data-side="end">
            @if (Clearable)
            {
                <button type="button" class="rax-input-clear" data-clear hidden aria-label="@ClearLabel">
                    @* X path from Lucide (ISC). *@
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                </button>
            }
            @if (Type == "password")
            {
                <button type="button" class="rax-input-action rax-input-eye" data-password hidden
                        data-show-label="@ShowLabel" data-hide-label="@HideLabel" aria-label="@ShowLabel" aria-pressed="false">
                    @* Eye paths from Lucide (ISC). *@
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" /><circle class="rax-input-eye-pupil" cx="12" cy="12" r="3" /><path class="rax-input-eye-slash" d="M4 4l16 16" pathLength="1" /></svg>
                </button>
            }
            @if (EndIcon is not null)
            {
                <label for="@ControlId" class="rax-input-slot" aria-hidden="true">@EndIcon</label>
            }
        </span>
    }
</div>
@code {
    /// <summary>text, email, password, number, or search. Use NumberInput for typed numeric binding.</summary>
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public RenderFragment? StartIcon { get; set; }
    [Parameter] public RenderFragment? EndIcon { get; set; }
    [Parameter] public bool Clearable { get; set; }
    [Parameter] public string ClearLabel { get; set; } = "Clear";
    [Parameter] public string ShowLabel { get; set; } = "Show password";
    [Parameter] public string HideLabel { get; set; } = "Hide password";
    /// <summary>default, sm, or lg.</summary>
    [Parameter] public string Size { get; set; } = "default";
    [Parameter] public string Variant { get; set; } = "filled";
    private string? SizeClass => Size == "default" ? null : $"form-control-{Size}";

    /// <summary>Bound value, including EditContext validation and static SSR form mapping.</summary>
    [Parameter] public string? Value { get; set; } = "";
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<string?>>? ValueExpression { get; set; }
    // Unbound use (no @bind-Value): the inner input still needs an expression, so point it at this component's own value.
    private System.Linq.Expressions.Expression<Func<string?>>? _ownValueExpression;
    private System.Linq.Expressions.Expression<Func<string?>> OwnValueExpression => ValueExpression ?? (_ownValueExpression ??= () => Value);

    [CascadingParameter] private Field.FieldContext? FieldContext { get; set; }
    /// <summary>default, flat, or glass; null inherits the surrounding theme.</summary>
    [Parameter] public string? Appearance { get; set; }
    /// <summary>Extra CSS classes appended to the control.</summary>
    [Parameter] public string? Class { get; set; }
    private string? ExtraClass => AdditionalAttributes is not null && AdditionalAttributes.TryGetValue("class", out var value) ? Convert.ToString(value) : null;
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    private readonly string _autoId = $"rax-control-{Guid.NewGuid():N}";
    private Dictionary<string, object> ControlAttributes
    {
        get
        {
            var attrs = FieldContext is null ? new Dictionary<string, object>() : new(FieldContext.ControlAttributes);
            if (AdditionalAttributes is not null)
                foreach (var pair in AdditionalAttributes) attrs[pair.Key] = pair.Value;
            if (!attrs.ContainsKey("id")) attrs["id"] = _autoId;
            return attrs;
        }
    }
    private string ControlId => Convert.ToString(ControlAttributes["id"])!;

    private ElementReference _element;
    private Microsoft.JSInterop.IJSObjectReference? _module;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!(Clearable || Type == "password")) return;
        _module ??= await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>("import", "./Components/UI/Input/Input.razor.js");
        await _module.InvokeVoidAsync("init", _element);
    }
    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("dispose", _element); await _module.DisposeAsync(); }
        catch (Microsoft.JSInterop.JSDisconnectedException) { /* The circuit has already gone away. */ }
    }

}
