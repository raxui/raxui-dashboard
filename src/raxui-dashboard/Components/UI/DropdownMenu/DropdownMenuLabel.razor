@* RaxUI DropdownMenuLabel. Source-owned: edit freely. A heading for a group of items; not selectable. *@

<div @attributes="AdditionalAttributes" class="@CssClass">@ChildContent</div>

@code {
    /// <summary>Extra CSS classes appended after the component's own classes.</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => string.IsNullOrEmpty(Class) ? "rax-dropdown-label" : $"rax-dropdown-label {Class}";
}
