@* RaxUI DropdownMenuItem. Source-owned: edit freely. Selecting it runs OnSelect and closes the menu. *@

<button @attributes="AdditionalAttributes"
        type="button"
        role="@Role"
        tabindex="-1"
        class="@CssClass"
        disabled="@Disabled"
        @onclick="OnSelect">
    @ChildContent
</button>

@code {
    /// <summary>Runs when the item is clicked or chosen with Enter or Space.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnSelect { get; set; }

    /// <summary>A disabled item is skipped by the keyboard and cannot be selected.</summary>
    [Parameter] public string Role { get; set; } = "menuitem";
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Extra CSS classes appended after the component's own classes.</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => string.IsNullOrEmpty(Class) ? "rax-dropdown-item" : $"rax-dropdown-item {Class}";
}
