@* RaxUI Skeleton. Source-owned: edit freely. Styled by the skeleton component CSS. *@
@if (ChildContent is not null && !Loading) { @ChildContent }
else
{
    <span @attributes="AdditionalAttributes" class="@($"rax-skeleton {Class}")" aria-hidden="true" inert="@(ChildContent is not null ? "" : null)" data-content="@(ChildContent is not null ? "true" : null)" data-shape="@Shape" data-animation="@Animation" data-rax-appearance="@Appearance" style="@CssStyle">@ChildContent</span>
}
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>default, flat, or glass; null inherits the surrounding theme.</summary>
    [Parameter] public string? Appearance { get; set; }
    /// <summary>Extra CSS classes.</summary>
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IDictionary<string, object>? AdditionalAttributes { get; set; }
    /// <summary>rect, circle, pill, or text.</summary>
    [Parameter] public string Shape { get; set; } = "rect";
    [Parameter] public string? Width { get; set; }
    [Parameter] public string? Height { get; set; }
    [Parameter] public string Animation { get; set; } = "shimmer";
    [Parameter] public bool Loading { get; set; } = true;
    private string CssStyle => $"width:{Width};height:{Height ?? (Shape == "circle" ? Width : null)};{(AdditionalAttributes?.TryGetValue("style", out var style) == true ? style : null)}";
}
