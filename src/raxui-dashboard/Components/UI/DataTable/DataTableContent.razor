@* Built-in SVG paths from Lucide (ISC). *@
@typeparam TItem
<div class="rax-table-frame">
<Table Density="@State.Density" StickyHeader="@(MaxHeight is not null)" ContainerStyle="@(MaxHeight is null?null:$"max-height:{MaxHeight};overflow:auto")" aria-label="@Label" aria-busy="@(Loading?"true":null)">
<TableHeader><TableRow>
    @if(Selectable){<TableHead><Checkbox disabled="@(!Interactive)" Value="@All" Indeterminate="@Some" ValueChanged="TogglePage" aria-label="@Text.SelectAll" /></TableHead>}
    @foreach(var c in State.Visible){
        var sort=State.Sorting.FirstOrDefault(x=>x.ColumnId==c.Id);
        <TableHead Class="@(c.Align=="end"?"text-end":c.Align=="center"?"text-center":null)" aria-sort="@(sort is null?null:sort.Descending?"descending":"ascending")">
            @if(c.Sortable){<button type="button" disabled="@(!Interactive)" class="rax-table-sort" data-sort="@(sort is null?null:sort.Descending?"desc":"asc")" @onclick="e=>Sort(c.Id,e.ShiftKey)">@c.Title<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m8 9 4-4 4 4M12 5v14" /></svg></button>}
            else {@c.Title}
        </TableHead>
    }
</TableRow></TableHeader>
<TableBody>
@if(Loading){
    @for(var i=0;i<Math.Min(State.PageSize,10);i++){<TableRow>@for(var j=0;j<State.Visible.Count()+(Selectable?1:0);j++){<TableCell><span class="rax-table-skeleton"></span></TableCell>}</TableRow>}
} else if(State.Filtered.Count==0){<TableRow><TableCell Class="rax-table-empty" colspan="@(State.Visible.Count()+(Selectable?1:0))">@if(EmptyState is not null){@EmptyState}else{@Text.Empty}</TableCell></TableRow>}
else {
    @foreach(var row in State.PageRows){
        var id=State.Id(row);
        <TableRow @key="id" data-state="@(State.Selected.Contains(id)?"selected":null)">
            @if(Selectable){<TableCell><Checkbox disabled="@(!Interactive)" Value="@State.Selected.Contains(id)" ValueChanged="()=>Toggle(id)" aria-label="@($"{Text.SelectRow} {id}")" /></TableCell>}
            @foreach(var c in State.Visible){<TableCell @key="c.Id" Class="@($"{c.Class} {(c.Align=="end"?"text-end":c.Align=="center"?"text-center":"")}")">@if(c.Cell is not null){@c.Cell(row)}else{@c.Text(row)}</TableCell>}
        </TableRow>
    }
}
</TableBody>
</Table>
</div>
@code {
    [Parameter,EditorRequired] public DataTableState.State<TItem> State { get; set; } = default!;
    [Parameter] public DataTableTypes.Labels Text { get; set; } = new();
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public bool Selectable { get; set; } = true;
    [Parameter] public bool Interactive { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? MaxHeight { get; set; }
    [Parameter] public RenderFragment? EmptyState { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private bool All => State.PageRows.Any()&&State.PageRows.All(x=>State.Selected.Contains(State.Id(x)));
    private bool Some => !All&&State.PageRows.Any(x=>State.Selected.Contains(State.Id(x)));
    private async Task TogglePage(){State.TogglePage();await Changed.InvokeAsync();}
    private async Task Toggle(string id){State.Toggle(id);await Changed.InvokeAsync();}
    private async Task Sort(string id,bool multi){State.SortBy(id,multi);await Changed.InvokeAsync();}
}
